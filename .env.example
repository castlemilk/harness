# Database (postgresql:// URL is required by Prisma; actual storage is in DATABASE_DIR)
DATABASE_URL="postgresql://localhost:5432/omega"
DATABASE_DIR="./pglite-data"

# PGlite WASM recovery:
# When the data dir is corrupted (WASM abort on init), the server's startup
# routine snapshots the dir to .corrupt-{timestamp}. To recover:
#   1. Restart the server — pre-init snapshot will move the bad dir aside
#      and the next PGlite init will run against an empty (recreated) dir.
#   2. OR: build the package and run the standalone reset CLI:
#        pnpm --filter @omega/db build && node packages/db/dist/cli-reset.js --yes
#      This wipes the data dir (requires --yes to prevent accidents).

# Provider API keys (only needed if you configure cloud providers)
# OpenRouter: seeds a provider restricted to FREE models only (see seed.ts)
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
KIMI_API_KEY=""
GLM_API_KEY=""

# Set to any non-empty value to disable the seeded Kimi provider
OMEGA_DISABLE_KIMI=""

# Local model endpoint
OLLAMA_BASE_URL="http://localhost:11434"

# Server bind configuration (defaults shown; HOST defaults to loopback only)
PORT=4000
GRPC_PORT=50051
HOST=127.0.0.1

# Per-task token cap; counts prompt + completion tokens across all model turns.
# Free/shared models often need 50k-100k because the planning prompt is large.
# Leave empty for no cap, or set OMEGA_TOKEN_BUDGET=100000 for free-tier runs.
OMEGA_TOKEN_BUDGET=""

# Scale complexity deadlines for slow/shared model pools (minimum 1; optional)
# OMEGA_DEADLINE_MULTIPLIER=6

# Auto-retry on transient failures (default: true).
# Set to 'false' to disable auto-retry; manual POST /tasks/:id/retry still works.
OMEGA_AUTO_RETRY=true

# Agent logging: OMEGA_LOG_LEVEL=debug|info|warn|error, OMEGA_LOG_FORMAT=json|text
OMEGA_LOG_LEVEL=""
OMEGA_LOG_FORMAT=""

# Storage root for all harness runtime data (reports, jobs, DB, worktrees,
# verifier tools). Defaults to ~/.omega if unset. Set this to an external
# volume when local disk space is limited.
# OMEGA_STORAGE_ROOT="/Volumes/gamma-systems-2/omega"

# Advanced overrides (rarely needed; sensible defaults are computed)
# SKILLS_DIR="./.agents/skills"
# WEB_DIST_DIR="./apps/web/dist"
# OMEGA_PROTO_PATH="./proto/tasks.proto"
# HARNESS_API_URL="http://localhost:4000"
# HARNESS_GRPC_TARGET="localhost:50051"
# OMEGA_HARNESS_ROOT="/path/to/harness"

# Foreman tool execution. FOREMAN_TOOLS=1 lets a Toolkit button run the tool's
# stored shell command in the objective's project checkout — a browser button
# running a command on this host, as you. Off by default.
# FOREMAN_TOOLS=1
#
# When set, POST /foreman/harnesses/:id/tools/:toolId/run and resolving an
# `approval` intervention both require header `x-foreman-tools-secret` to match
# (401 otherwise, with no run row and no permission write). The READS that carry
# a command or a captured output — GET /foreman/harnesses/:id/tools,
# GET /foreman/harnesses/:id, GET /foreman/objectives/:id/state,
# GET /foreman/interventions and GET /foreman/stream — want the same header, but
# answer without it: `command`, `lastRun.output` and an approval's command are
# replaced by «secret required» while names and statuses stay. The stream also
# takes the secret as ?toolsSecret= because EventSource cannot set a header.
# Unset = the routes are unauthenticated and the loopback bind is the only fence.
# FOREMAN_TOOLS_SECRET="a-long-random-string"
#
# The web build sends the header when given VITE_FOREMAN_TOOLS_SECRET. A secret
# compiled into a served SPA is readable by anyone who loads the page: it is a
# CSRF-grade control for local dev, not an authentication boundary.
# VITE_FOREMAN_TOOLS_SECRET="a-long-random-string"

# ---------------------------------------------------------------------------
# DeepSWE benchmarking (see docs/DEEPSWE-QUICKSTART.md for the full runbook)
# ---------------------------------------------------------------------------

# Prompt experiments — both default ON. "0" reproduces the pre-Tier-2 prompt
# byte-for-byte (the 4/8 §1b baseline). Keep them constant across any
# comparison you intend to quote.
# OMEGA_DEEPSWE_SPEC_GATE=1
# OMEGA_DEEPSWE_TIME_BUDGET=1

# Repo mirror cache: per-task checkouts served from per-repo bare mirrors on
# disk (no network on repeat clones). Default lives under OMEGA_STORAGE_ROOT;
# point it at a volume with room and skip mirror creation under 15 GiB free.
# Set OMEGA_DEEPSWE_DISABLE_REPO_CACHE=1 for the plain retrying direct-clone
# path. Measured cost: the 8-task scoring set is ~96 MB of mirrors.
# OMEGA_DEEPSWE_REPO_CACHE_DIR="/Volumes/your-volume/omega/deepswe-repo-cache"
# OMEGA_DEEPSWE_REPO_CACHE_MIN_FREE_GB=15
# OMEGA_DEEPSWE_DISABLE_REPO_CACHE=0
# OMEGA_DEEPSWE_CLONE_DEADLINE_MS=600000

# Internal-loop runs apply stored solution patches from .agents/skills and
# (unless this is "true") mark the task passed without the model doing
# anything. Benchmark through external CLIs (external:opencode etc.) to avoid
# it, or set this to verify stored skills still pass.
# OMEGA_SKILL_VERIFY=false
