# Database (postgresql:// URL is required by Prisma; actual storage is in DATABASE_DIR)
DATABASE_URL="postgresql://localhost:5432/omega"
DATABASE_DIR="./pglite-data"

# PGlite WASM recovery:
# When the data dir is corrupted (WASM abort on init), the server's startup
# routine snapshots the dir to .corrupt-{timestamp}. To recover:
#   1. Restart the server — pre-init snapshot will move the bad dir aside
#      and the next PGlite init will run against an empty (recreated) dir.
#   2. OR: build the package and run the standalone reset CLI:
#        pnpm --filter @omega/db build && node packages/db/dist/cli-reset.js --yes
#      This wipes the data dir (requires --yes to prevent accidents).

# Provider API keys (only needed if you configure cloud providers)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
KIMI_API_KEY=""
GLM_API_KEY=""

# Set to any non-empty value to disable the seeded Kimi provider
OMEGA_DISABLE_KIMI=""

# Local model endpoint
OLLAMA_BASE_URL="http://localhost:11434"

# Server bind configuration (defaults shown; HOST defaults to loopback only)
PORT=4000
GRPC_PORT=50051
HOST=127.0.0.1

# Per-task token cap; agent loop aborts if exceeded (optional)
OMEGA_TOKEN_BUDGET=""

# Auto-retry on transient failures (default: true).
# Set to 'false' to disable auto-retry; manual POST /tasks/:id/retry still works.
OMEGA_AUTO_RETRY=true

# Agent logging: OMEGA_LOG_LEVEL=debug|info|warn|error, OMEGA_LOG_FORMAT=json|text
OMEGA_LOG_LEVEL=""
OMEGA_LOG_FORMAT=""

# Storage root for all harness runtime data (reports, jobs, DB, worktrees,
# verifier tools). Defaults to ~/.omega if unset. Set this to an external
# volume when local disk space is limited.
# OMEGA_STORAGE_ROOT="/Volumes/gamma-systems-2/omega"

# Advanced overrides (rarely needed; sensible defaults are computed)
# SKILLS_DIR="./.agents/skills"
# WEB_DIST_DIR="./apps/web/dist"
# OMEGA_PROTO_PATH="./proto/tasks.proto"
# HARNESS_API_URL="http://localhost:4000"
# HARNESS_GRPC_TARGET="localhost:50051"
# OMEGA_HARNESS_ROOT="/path/to/harness"
