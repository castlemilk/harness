index 0000000..02b0c5f
--- /dev/null
+++ b/src/task-queue.ts
@@ -0,0 +1,418 @@
+/**
+ * Options controlling automatic retries with exponential backoff.
+ *
+ * On failure, the task is rescheduled after a delay:
+ *   delay = min(maxDelay, baseDelay × backoffMultiplier^attempt)
+ *
+ * When `jitter` is enabled (default), uniform jitter is applied while
+ * keeping the resulting delay non-negative.
+ */
+export interface RetryOptions {
+  /** Maximum number of retry attempts before giving up. Must be >= 0. */
+  maxRetries: number;
+
+  /** Base backoff delay in milliseconds. Must be >= 0. */
+  baseDelay: number;
+
+  /** Maximum backoff delay in milliseconds. Must be >= 0. */
+  maxDelay: number;
+
+  /** Multiplier applied each retry attempt. @default 2 */
+  backoffMultiplier?: number;
+
+  /** If true (default), apply uniform jitter (delay × U(0.5, 1.5)). */
+  jitter?: boolean;
+
+  /**
+   * Optional predicate deciding whether a given error is retryable.
+   * Return `false` to fail immediately without retrying. When omitted,
+   * every error is considered retryable.
+   */
+  retryOn?: (error: unknown) => boolean;
+}
+
+/**
+ * Options accepted when enqueuing a task.
+ */
+export interface TaskOptions {
+  /**
+   * Scheduling priority. Higher values run before lower values.
+   * Tasks with equal priority run in FIFO (enqueue) order.
+   * @default 0
+   */
+  priority?: number;
+  /** Retry / backoff configuration. */
+  retry?: RetryOptions;
+}
+
+/**
+ * Handle returned from {@link TaskQueue.enqueue}. Exposes a promise that
+ * settles with the task's result (or rejection).
+ */
+export interface TaskHandle<T> {
+  /** Resolves with the task result, or rejects if the task throws. */
+  readonly promise: Promise<T>;
+}
+
+/**
+ * Constructor options for {@link TaskQueue}.
+ */
+export interface TaskQueueOptions {
+  /**
+   * Maximum number of tasks allowed to run concurrently.
+   * Must be a positive integer, or `Infinity` for unbounded.
+   * @default Infinity
+   */
+  maxConcurrency?: number;
+}
+
+/**
+ * Defer a callback to a later macrotask (or microtask fallback). Ensures
+ * callbacks are never invoked synchronously from within enqueue/execute.
+ */
+const defer: (callback: () => void) => void = (() => {
+  const g = globalThis as {
+    setImmediate?: (cb: () => void) => unknown;
+  };
+
+  if (typeof g.setImmediate === 'function') {
+    return (cb) => g.setImmediate!(cb);
+  }
+
+  return (cb) => {
+    setTimeout(cb, 0);
+  };
+})();
+
+interface QueueItem<T> {
+  priority: number;
+  sequence: number;
+  run: () => T | Promise<T>;
+  retry?: RetryOptions;
+  resolve: (value: T | PromiseLike<T>) => void;
+  attempt: number;
+  reject: (reason?: unknown) => void;
+}
+
+/**
+ * A priority-aware task queue with bounded concurrency and a drain signal.
+ *
+ * Tasks are scheduled by priority (higher first) using an internal binary
+ * heap, with FIFO ordering as a tie-breaker. At most `maxConcurrency` tasks
+ * execute at the same time. {@link TaskQueue.drain} resolves once every
+ * queued and in-flight task has settled.
+ */
+export class TaskQueue<T = unknown> {
+  private readonly maxConcurrency: number;
+
+  /** Binary max-heap ordered by (priority desc, sequence asc). */
+  private readonly heap: Array<QueueItem<T>> = [];
+
+  /** Number of tasks currently executing. */
+  private activeCount = 0;
+
+  /** Number of retry timers currently pending. */
+  private pendingRetries = 0;
+
+  /** Monotonic counter used to break priority ties in FIFO order. */
+  private sequence = 0;
+
+  /** Resolvers waiting for the queue to become fully idle. */
+  private drainResolvers: Array<() => void> = [];
+
+  constructor(options: TaskQueueOptions = {}) {
+    const maxConcurrency = options.maxConcurrency ?? Number.POSITIVE_INFINITY;
+
+    if (
+      maxConcurrency !== Number.POSITIVE_INFINITY &&
+      (!Number.isInteger(maxConcurrency) || maxConcurrency <= 0)
+    ) {
+      throw new RangeError(
+        'maxConcurrency must be a positive integer or Infinity',
+      );
+    }
+
+    this.maxConcurrency = maxConcurrency;
+  }
+
+  /**
+   * Number of tasks waiting to be scheduled (excludes in-flight tasks).
+   */
+  get size(): number {
+    return this.heap.length;
+  }
+
+  /**
+   * Number of tasks currently executing.
+   */
+  get active(): number {
+    return this.activeCount;
+  }
+
+  /**
+   * Schedule a task for execution.
+   *
+   * @param task A function returning a value or promise.
+   * @param options Scheduling options (e.g. priority).
+   * @returns A handle whose `promise` settles with the task outcome.
+   */
+  enqueue(
+    task: () => T | Promise<T>,
+    options: TaskOptions = {},
+  ): TaskHandle<T> {
+    if (typeof task !== 'function') {
+      throw new TypeError('task must be a function');
+    }
+
+    const priority = options.priority ?? 0;
+
+    // Validate retry options eagerly so misuse fails fast.
+    const retry = options.retry;
+    if (retry !== undefined) {
+      if (
+        typeof retry.maxRetries !== 'number' ||
+        !Number.isFinite(retry.maxRetries) ||
+        retry.maxRetries < 0
+      ) {
+        throw new RangeError('retry.maxRetries must be a non-negative number');
+      }
+      if (
+        typeof retry.baseDelay !== 'number' ||
+        !Number.isFinite(retry.baseDelay) ||
+        retry.baseDelay < 0
+      ) {
+        throw new RangeError('retry.baseDelay must be a non-negative number');
+      }
+      if (
+        typeof retry.maxDelay !== 'number' ||
+        !Number.isFinite(retry.maxDelay) ||
+        retry.maxDelay < 0
+      ) {
+        throw new RangeError('retry.maxDelay must be a non-negative number');
+      }
+    }
+
+    let resolve!: (value: T | PromiseLike<T>) => void;
+    let reject!: (reason?: unknown) => void;
+    const promise = new Promise<T>((res, rej) => {
+      resolve = res;
+      reject = rej;
+    });
+
+    const item: QueueItem<T> = {
+      priority,
+      sequence: this.sequence++,
+      run: task,
+      retry: options.retry,
+      resolve,
+      attempt: 0,
+      reject,
+    };
+
+    this.push(item);
+    this.schedule();
+
+    return { promise };
+  }
+
+  /**
+   * Resolves once all queued and in-flight tasks have settled. If the queue
+   * is already idle, the returned promise resolves on a later tick.
+   */
+  drain(): Promise<void> {
+    return new Promise<void>((resolve) => {
+      // Always defer so callers can rely on asynchronous resolution.
+      defer(() => {
+        if (this.isIdle()) {
+          resolve();
+          return;
+        }
+        this.drainResolvers.push(resolve);
+      });
+    });
+  }
+
+  private isIdle(): boolean {
+    return this.activeCount === 0 && this.heap.length === 0 && this.pendingRetries === 0;
+  }
+
+  /** Dispatch as many queued tasks as concurrency allows. */
+  private schedule(): void {
+    while (
+      this.heap.length > 0 &&
+      this.activeCount < this.maxConcurrency
+    ) {
+      const item = this.pop();
+      if (!item) {
+        break;
+      }
+
+      // Reserve the concurrency slot synchronously so concurrent schedule()
+      // calls cannot over-dispatch, then defer actual execution.
+      this.activeCount++;
+      defer(() => {
+        void this.execute(item);
+      });
+    }
+  }
+
+  private async execute(item: QueueItem<T>): Promise<void> {
+    try {
+      const value = await item.run();
+      item.resolve(value);
+    } catch (error) {
+      const retry = item.retry;
+
+      if (retry && item.attempt < retry.maxRetries && (!retry.retryOn || retry.retryOn(error))) {
+        // Compute delay with exponential backoff and optional jitter.
+        const attempt = item.attempt;
+        const baseDelay = retry.baseDelay;
+        const maxDelay = retry.maxDelay;
+        const multiplier = retry.backoffMultiplier ?? 2;
+        const jitter = retry.jitter ?? true;
+
+        const rawDelay = baseDelay * Math.pow(multiplier, attempt);
+        let delay = Math.min(maxDelay, rawDelay);
+
+        if (jitter) {
+          // Uniform jitter: final ∈ [0.5×delay, 1.5×delay]
+          const jittered = delay * (0.5 + Math.random());
+          delay = Math.max(0, jittered);
+        }
+
+        // Ensure delay is non-negative
+        delay = Math.max(0, delay);
+
+        // Increment attempt and re-enqueue with same priority and sequence.
+        // Reusing the original sequence preserves FIFO ordering relative to
+        // other tasks at the same priority.
+        const retryItem: QueueItem<T> = {
+          priority: item.priority,
+          sequence: item.sequence,
+          run: item.run,
+          retry,
+          resolve: item.resolve,
+          reject: item.reject,
+          attempt: item.attempt + 1,
+        };
+
+        // Always defer the re-enqueue to a later tick to keep execution
+        // strictly asynchronous — never call push/schedule synchronously
+        // from a task's catch handler.
+        defer(() => {
+          // Schedule the retry after the computed delay.
+          // We do NOT hold a concurrency slot during the delay — the slot
+          // is released and the retry will re-acquire one via schedule().
+          if (delay > 0) {
+            this.pendingRetries++;
+            const timer = setTimeout(() => {
+              this.pendingRetries--;
+              this.push(retryItem);
+              this.schedule();
+              this.settleDrainIfIdle();
+            }, delay);
+            // Allow the process to exit even if a retry is pending.
+            // Node.js environments: the timer handle is kept alive via pendingRetries
+            // and will be cleared by destroy() if needed.
+          } else {
+            // Push now; the finally block will call schedule() to pick it up.
+            this.push(retryItem);
+          }
+        });
+      } else {
+        // Either no retry config or maxRetries exhausted — permanent failure.
+        item.reject(error);
+      }
+    } finally {
+      // Release the concurrency slot that was held by this attempt.
+      this.activeCount--;
+      this.schedule();
+      this.settleDrainIfIdle();
+    }
+  }
+
+  private settleDrainIfIdle(): void {
+    if (!this.isIdle() || this.drainResolvers.length === 0) {
+      return;
+    }
+
+    const resolvers = this.drainResolvers;
+    this.drainResolvers = [];
+
+    defer(() => {
+      for (const resolve of resolvers) {
+        resolve();
+      }
+    });
+  }
+
+  // --- Binary max-heap (priority desc, sequence asc) -----------------------
+
+  /** True when `a` should run before `b`. */
+  private higher(a: QueueItem<T>, b: QueueItem<T>): boolean {
+    if (a.priority !== b.priority) {
+      return a.priority > b.priority;
+    }
+    return a.sequence < b.sequence;
+  }
+
+  /** Clamp an exponential retry delay to the configured maximum. */
+  private min(value: number, maximum: number): number {
+    return Math.min(value, maximum);
+  }
+
+  private push(item: QueueItem<T>): void {
+    this.heap.push(item);
+    this.siftUp(this.heap.length - 1);
+  }
+
+  private pop(): QueueItem<T> | undefined {
+    const top = this.heap[0];
+    const last = this.heap.pop();
+    if (this.heap.length > 0 && last !== undefined) {
+      this.heap[0] = last;
+      this.siftDown(0);
+    }
+    return top;
+  }
+
+  private siftUp(index: number): void {
+    const item = this.heap[index];
+    while (index > 0) {
+      const parent = (index - 1) >> 1;
+      if (!this.higher(item, this.heap[parent])) {
+        break;
+      }
+      this.heap[index] = this.heap[parent];
+      index = parent;
+    }
+    this.heap[index] = item;
+  }
+
+  private siftDown(index: number): void {
+    const length = this.heap.length;
+    const item = this.heap[index];
+    const half = length >> 1;
+
+    while (index < half) {
+      let best = index * 2 + 1;
+      const right = best + 1;
+
+      if (
+        right < length &&
+        this.higher(this.heap[right], this.heap[best])
+      ) {
+        best = right;
+      }
+
+      if (!this.higher(this.heap[best], item)) {
+        break;
+      }
+
+      this.heap[index] = this.heap[best];
+      index = best;
+    }
+
+    this.heap[index] = item;
+  }
+}
