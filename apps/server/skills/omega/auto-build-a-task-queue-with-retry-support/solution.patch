+        q.enqueue(async () => { await barrier.promise; order.push(2); return 2; }, { priority: 5 }),
+        q.enqueue(async () => { await barrier.promise; order.push(3); return 3; }, { priority: 5 }),
+      ];
+
+      await flushMicrotasks();
+      barrier.release();
+      await Promise.all(handles.map((h) => h.promise));
