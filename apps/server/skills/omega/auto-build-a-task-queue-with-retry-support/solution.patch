+  // ─────────────────────────────────────────────────────────────────────
+  describe('miscellaneous guarantees', () => {
+    it('throws TypeError for non-function tasks', () => {
+      const q = new TaskQueue();
+      expect(() => q.enqueue(null as unknown as () => void)).toThrow(TypeError);
+      expect(() => q.enqueue(undefined as unknown as () => void)).toThrow(TypeError);
+      expect(() => q.enqueue(42 as unknown as () => void)).toThrow(TypeError);
+      expect(() => q.enqueue({} as unknown as () => void)).toThrow(TypeError);
+    });
+
+    it('preserves FIFO ordering across retries within the same priority', async () => {
+      vi.useFakeTimers();
+      try {
+        const q = new TaskQueue({ maxConcurrency: 1 });
+        const order: string[] = [];
+
+        const a = q.enqueue(async () => {
+          order.push('a-run-1');
+          throw new Error('retry a');
+        }, { retry: { maxRetries: 1, baseDelay: 5, maxDelay: 5, jitter: false } });
+
+        const b = q.enqueue(async () => { order.push('b'); });
+
+        await vi.runAllTimersAsync();
+        await expect(a.promise).rejects.toThrow('retry a');
+        await b.promise;
+        // a runs, fails, b runs, then a retries. Final order: a-run-1, b.
+        expect(order).toEqual(['a-run-1', 'b']);
+      } finally {
+        await vi.runOnlyPendingTimersAsync();
+        vi.useRealTimers();
+      }
+    });
+
+    it('dispatches callbacks strictly asynchronously (no sync execution)', () => {
+      const q = new TaskQueue();
+      let enqueueReturned = false;
+      let taskStarted = false;
+
+      q.enqueue(() => { taskStarted = true; });
+
+      enqueueReturned = true;
+      // The task must NOT have started yet — enqueue defers execution.
+      expect(taskStarted).toBe(false);
+    });
+
+    it('handles a large burst deterministically', async () => {
+      const q = new TaskQueue<number>({ maxConcurrency: 8 });
+      const N = 200;
+      let running = 0;
+      let maxRunning = 0;
+
+      const handles = Array.from({ length: N }, (_, i) =>
+        q.enqueue(async () => {
+          running++;
+          maxRunning = Math.max(maxRunning, running);
+          // Tiny deterministic yield.
+          await new Promise((r) => setTimeout(r, 1));
+          running--;
+          return i;
+        }),
+      );
+
+      const results = await Promise.all(handles.map((h) => h.promise));
+      expect(results.length).toBe(N);
+      expect(results).toEqual(Array.from({ length: N }, (_, i) => i));
+      expect(maxRunning).toBeLessThanOrEqual(8);
+      expect(maxRunning).toBe(8);
+    });
