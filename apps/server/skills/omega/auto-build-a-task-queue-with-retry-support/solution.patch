+    it('enqueue preserves descending priority order for queued tasks', async () => {
+      const q = new TaskQueue<number>({ maxConcurrency: 1 });
+      const order: number[] = [];
+
+      // The first task begins executing immediately; hold it on a barrier
+      // so the remaining queued tasks pile up and are then re-ordered by
+      // priority once the first one releases.
+      const barrier = createBarrier();
+      const handles = [
+        q.enqueue(async () => {
+          await barrier.promise;
+          order.push(10);
+          return 10;
+        }, { priority: 1 }),
+        q.enqueue(async () => {
+          await barrier.promise;
+          order.push(1);
+          return 1;
+        }, { priority: 0 }),
+        q.enqueue(async () => {
+          await barrier.promise;
+          order.push(5);
+          return 5;
+        }, { priority: 2 }),
+      ];
+
+      // Let the first task start before we release it.
+      await flushMicrotasks();
+      barrier.release();
+      await Promise.all(handles.map((h) => h.promise));
+
+      // The running task was priority 1, then the heap serves 5 (p=2) → 1 (p=0).
+      expect(order).toEqual([10, 5, 1]);
+    });
+
+    it('breaks priority ties using FIFO (enqueue order)', async () => {
+      const q = new TaskQueue<number>({ maxConcurrency: 1 });
+      const order: number[] = [];
