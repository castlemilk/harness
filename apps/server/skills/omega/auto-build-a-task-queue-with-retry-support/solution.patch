+++ b/src/task-queue.test.ts
@@ -0,0 +1,297 @@
+import { describe, it, expect, vi } from 'vitest';
+import { TaskQueue } from './task-queue.js';
+
+describe('TaskQueue', () => {
+  // --- priority ordering and FIFO tie-break ---
+  it('should execute tasks by priority (higher first) and FIFO for ties', async () => {
+    const q = new TaskQueue<number>({ maxConcurrency: 1 });
+    const order: number[] = [];
+    let release!: () => void;
+    const barrier = new Promise<void>((r) => { release = r; });
+
+    const handles = [
+      q.enqueue(async () => { await barrier; order.push(1); return 1; }, { priority: 0 }),
+      q.enqueue(async () => { await barrier; order.push(2); return 2; }, { priority: 10 }),
+      q.enqueue(async () => { await barrier; order.push(3); return 3; }, { priority: 5 }),
+      q.enqueue(async () => { await barrier; order.push(4); return 4; }, { priority: 0 }),
+      q.enqueue(async () => { await barrier; order.push(5); return 5; }, { priority: 10 }),
+    ];
+
+    release();
+    const results = await Promise.all(handles.map((h) => h.promise));
+
+    // Task 1 (priority 0) was already active before others queued;
+    // after it completes, remaining tasks run by priority: 2(p10), 5(p10), 3(p5), 4(p0)
+    expect(order).toEqual([1, 2, 5, 3, 4]);
+    expect(results).toEqual([1, 2, 3, 4, 5]);
+  });
+
+  // --- maxConcurrency limits and slot release ---
+  it('should respect maxConcurrency and release slots after completion', async () => {
+    const q = new TaskQueue({ maxConcurrency: 2 });
+    let running = 0;
+    let maxRunning = 0;
+
+    const tasks = Array.from({ length: 5 }, (_, i) =>
+      q.enqueue(async () => {
+        running++;
+        maxRunning = Math.max(maxRunning, running);
+        await new Promise((r) => setTimeout(r, 0));
+        running--;
+        return i;
+      }),
+    );
+
+    await Promise.all(tasks.map((h) => h.promise));
+    expect(maxRunning).toBeLessThanOrEqual(2);
+    expect(maxRunning).toBe(2);
+  });
+
+  // --- drain() resolving when idle ---
+  it('drain() should resolve when queue is idle', async () => {
+    const q = new TaskQueue();
+    await q.drain(); // should resolve on next tick
+  });
+
+  it('drain() should resolve after tasks finish', async () => {
+    const q = new TaskQueue({ maxConcurrency: 2 });
+    let done = false;
+
+    q.enqueue(async () => {
+      await new Promise((r) => setTimeout(r, 20));
+      done = true;
+    });
+
+    await q.drain();
+    expect(done).toBe(true);
+  });
+
+  // --- enqueue validation errors ---
+  it('should throw TypeError when task is not a function', () => {
+    const q = new TaskQueue();
+    expect(() => q.enqueue(null as any)).toThrow(TypeError);
+    expect(() => q.enqueue(undefined as any)).toThrow(TypeError);
+    expect(() => q.enqueue(42 as any)).toThrow(TypeError);
+  });
+
+  it('should throw RangeError for invalid retry options', () => {
+    const q = new TaskQueue();
+    expect(() =>
+      q.enqueue(() => {}, { retry: { maxRetries: -1, baseDelay: 0, maxDelay: 0 } }),
+    ).toThrow(RangeError);
+    expect(() =>
+      q.enqueue(() => {}, { retry: { maxRetries: 0, baseDelay: -1, maxDelay: 0 } }),
+    ).toThrow(RangeError);
+    expect(() =>
+      q.enqueue(() => {}, { retry: { maxRetries: 0, baseDelay: 0, maxDelay: -1 } }),
+    ).toThrow(RangeError);
+    expect(() =>
+      q.enqueue(() => {}, { retry: { maxRetries: NaN, baseDelay: 0, maxDelay: 0 } }),
+    ).toThrow(RangeError);
+    expect(() =>
+      q.enqueue(() => {}, { retry: { maxRetries: Infinity, baseDelay: 0, maxDelay: 0 } }),
+    ).toThrow(RangeError);
+  });
+
+  it('should throw RangeError for invalid maxConcurrency', () => {
+    expect(() => new TaskQueue({ maxConcurrency: 0 })).toThrow(RangeError);
+    expect(() => new TaskQueue({ maxConcurrency: -1 })).toThrow(RangeError);
+    expect(() => new TaskQueue({ maxConcurrency: 1.5 })).toThrow(RangeError);
+  });
+
+  // --- retry success after transient failure ---
+  it('should retry and succeed after transient failures', async () => {
+    const q = new TaskQueue();
+    let attempts = 0;
+
+    const result = await q.enqueue(
+      () => {
+        attempts++;
+        if (attempts < 3) throw new Error('transient');
+        return 'ok';
+      },
+      {
+        retry: { maxRetries: 3, baseDelay: 1, maxDelay: 10 },
+      },
+    ).promise;
+
+    expect(result).toBe('ok');
+    expect(attempts).toBe(3);
+  });
+
+  // --- retry exhaustion rejecting ---
+  it('should reject after exhausting retries (maxRetries = 0)', async () => {
+    const q = new TaskQueue();
+    await expect(
+      q.enqueue(
+        () => { throw new Error('boom'); },
+        { retry: { maxRetries: 0, baseDelay: 0, maxDelay: 0 } },
+      ).promise,
+    ).rejects.toThrow('boom');
+  });
+
+  it('should reject after exhausting retries', async () => {
+    const q = new TaskQueue();
+    let attempts = 0;
+
+    await expect(
+      q.enqueue(
+        () => {
+          attempts++;
+          throw new Error('persistent');
+        },
+        {
+          retry: { maxRetries: 2, baseDelay: 1, maxDelay: 10 },
+        },
+      ).promise,
+    ).rejects.toThrow('persistent');
+
+    expect(attempts).toBe(3); // initial + 2 retries
+  });
+
+  // --- exponential backoff delay growth (fake timers) ---
+  it('should grow delay with exponential backoff', async () => {
+    vi.useFakeTimers();
+    try {
+      const q = new TaskQueue();
+      let attempts = 0;
+
+      const promise = q.enqueue(
+        () => {
+          attempts++;
+          if (attempts < 3) throw new Error('fail');
+          return attempts;
+        },
+        {
+          retry: { maxRetries: 3, baseDelay: 5, maxDelay: 100, backoffMultiplier: 2, jitter: false },
+        },
+      ).promise;
+
+      // First attempt runs asynchronously; flush microtasks/timers until settled.
+      await vi.runAllTimersAsync();
+
+      const result = await promise;
+      expect(result).toBe(3);
+      expect(attempts).toBe(3);
+    } finally {
+      await vi.runOnlyPendingTimersAsync();
+      vi.useRealTimers();
+    }
+  });
+
+  // --- concurrency preserved across retries ---
+  it('should preserve concurrency during retries', async () => {
+    const q = new TaskQueue({ maxConcurrency: 2 });
+    let running = 0;
+    let maxRunning = 0;
+
+    const tasks = Array.from({ length: 4 }, (_, i) =>
+      q.enqueue(
+        async () => {
+          running++;
+          maxRunning = Math.max(maxRunning, running);
+        await new Promise((r) => setTimeout(r, 0));
+          if (i === 0) {
+            running--;
+            throw new Error('retry me');
+          }
+          running--;
+          return i;
+        },
+        i === 0 ? { retry: { maxRetries: 2, baseDelay: 1, maxDelay: 10, backoffMultiplier: 2 } } : undefined,
+      ),
+    );
+
+    await expect(tasks[0].promise).rejects.toThrow('retry me');
+    await Promise.all(tasks.slice(1).map((h) => h.promise));
+
+    // Concurrency should never exceed maxConcurrency even with retries
+    expect(maxRunning).toBeLessThanOrEqual(2);
+  });
+
+  // --- callbacks never fire synchronously ---
+  it('should not invoke callbacks synchronously', async () => {
+    const q = new TaskQueue();
+    let enqueueReturned = false;
+    let taskStarted = false;
+
+    q.enqueue(() => {
+      taskStarted = true;
+      return 1;
+    });
+
+    enqueueReturned = true;
+    expect(taskStarted).toBe(false);
+
+    // Wait for task to actually execute
+    await q.drain();
+    expect(taskStarted).toBe(true);
+  });
+
+  it('should not resolve drain synchronously when queue is busy', () => {
+    const q = new TaskQueue({ maxConcurrency: 1 });
+    let drainResolved = false;
+
+    q.enqueue(async () => {
+      await new Promise((r) => setTimeout(r, 30));
+    });
+
+    q.drain().then(() => {
+      drainResolved = true;
+    });
+
+    // Should not have resolved synchronously
+    expect(drainResolved).toBe(false);
+  });
+
+  // --- retryOn predicate ---
+  it('should not retry when retryOn returns false', async () => {
+    const q = new TaskQueue();
+    let attempts = 0;
+
+    await expect(
+      q.enqueue(
+        () => {
+          attempts++;
+          throw new Error('non-retryable');
+        },
+        {
+          retry: {
+            maxRetries: 3,
+            baseDelay: 1,
+            maxDelay: 10,
+            retryOn: (err) => (err as Error).message !== 'non-retryable',
+          },
+        },
+      ).promise,
+    ).rejects.toThrow('non-retryable');
+
+    expect(attempts).toBe(1);
+  });
+
+  // --- size and active properties ---
+  it('should report correct size and active counts', async () => {
+    const q = new TaskQueue({ maxConcurrency: 1 });
+
+    expect(q.size).toBe(0);
+    expect(q.active).toBe(0);
+
+    const h1 = q.enqueue(async () => {
+      await new Promise((r) => setTimeout(r, 20));
+      return 1;
+    });
+
+    // After enqueue with maxConcurrency=1, one task should be active immediately (deferred)
+        await new Promise((r) => setTimeout(r, 0));
+    expect(q.active).toBe(1);
+
+    const h2 = q.enqueue(() => 2);
+    expect(q.size).toBe(1); // waiting
+
+    await h1.promise;
+    await h2.promise;
+
+    expect(q.active).toBe(0);
+    expect(q.size).toBe(0);
+  });
+});
