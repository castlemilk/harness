+      await p2;
+      expect(firstRan).toBe(true);
+      expect(secondRan).toBe(true);
+      expect(q.active).toBe(0);
+      expect(q.size).toBe(0);
+    });
+
+    it('resolves drain() after the last task is cancelled mid-flight', async () => {
+      const controller = new AbortController();
+      const q = new TaskQueue({ maxConcurrency: 1 });
+      let drained = false;
+
+      const task = q.enqueue(() => new Promise<number>((_resolve, reject) => {
+        controller.signal.addEventListener('abort', () => reject(new Error('cancelled')));
+      }));
+
+      const drainPromise = q.drain().then(() => { drained = true; });
+
+      controller.abort();
+      await expect(task.promise).rejects.toThrow('cancelled');
+      await drainPromise;
+      expect(drained).toBe(true);
+    });
