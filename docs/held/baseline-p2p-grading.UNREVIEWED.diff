+export function gradeDeepSWETestResults(
+  f2pResults: readonly DeepSWETestResult[],
+  p2pResults: readonly DeepSWETestResult[],
+  baselineFailingP2p?: ReadonlySet<string>
+): DeepSWEGrade {
+  const f2pPassed = f2pResults.filter((result) => result.status === 'passed').length;
+  const p2pPassed = p2pResults.filter((result) => result.status === 'passed').length;
+  const excludedP2p = baselineFailingP2p
+    ? p2pResults.filter(
+        (result) => result.status !== 'passed' && baselineFailingP2p.has(result.id)
+      )
+    : [];
+  const p2pTotal = p2pResults.length - excludedP2p.length;
+  const total = f2pResults.length + p2pTotal;
+  const baselineDisclosure = baselineFailingP2p
+    ? ` (${String(excludedP2p.length)} pre-existing ${excludedP2p.length === 1 ? 'failure' : 'failures'} excluded by baseline)`
+    : '';
+
+  return {
+    reward:
+      f2pResults.length > 0 &&
+      f2pPassed === f2pResults.length &&
+      p2pPassed === p2pTotal
+        ? 1
+        : 0,
+    f2p_total: f2pResults.length,
+    f2p_passed: f2pPassed,
+    p2p_total: p2pTotal,
+    p2p_passed: p2pPassed,
+    f2p: f2pResults.length > 0 ? f2pPassed / f2pResults.length : 0,
+    p2p: p2pTotal > 0 ? p2pPassed / p2pTotal : 1,
+    partial: total > 0 ? (f2pPassed + p2pPassed) / total : 0,
+    baseline_excluded_p2p: excludedP2p.length,
+    baseline_excluded_p2p_ids: excludedP2p.map((result) => result.id),
+    p2p_disclosure: `p2p ${String(p2pPassed)}/${String(p2pTotal)}${baselineDisclosure}`,
+  };
+}
+
+export function failingP2PBaselineIds(p2pResults: readonly DeepSWETestResult[]): string[] {
+  const missingReportPrefix = 'missing from report (test did not run or produced no result';
+  const missingResults = p2pResults.filter(
+    (result) => result.message?.startsWith(missingReportPrefix) === true
+  );
+  if (missingResults.length > 0) {
+    throw new Error(
+      missingResults.length === p2pResults.length
+        ? 'clean verifier produced no p2p test results'
+        : 'clean verifier has missing p2p test results'
+    );
+  }
+  return [
+    ...new Set(
+      p2pResults
+        .filter((result) => result.status !== 'passed')
+        .map((result) => result.id)
+    ),
+  ].sort();
 }
 
