+async function readDeepSWETestResults(verifierDir: string): Promise<DeepSWETestBuckets> {
+  const raw = await fs.readFile(path.join(verifierDir, 'ctrf.json'), 'utf-8');
+  const parsed: unknown = JSON.parse(raw);
+  if (typeof parsed !== 'object' || parsed === null) {
+    throw new Error('ctrf.json is not an object');
+  }
+  const results = (parsed as Record<string, unknown>).results;
+  if (typeof results !== 'object' || results === null) {
+    throw new Error('ctrf.json has no results object');
+  }
+  const tests = (results as Record<string, unknown>).tests;
+  if (!Array.isArray(tests)) {
+    throw new Error('ctrf.json has no tests array');
+  }
+
+  const buckets: DeepSWETestBuckets = { f2p: [], p2p: [] };
+  for (const value of tests) {
+    if (typeof value !== 'object' || value === null) continue;
+    const test = value as Record<string, unknown>;
+    if (typeof test.name !== 'string' || typeof test.status !== 'string') continue;
+    const result: DeepSWETestResult = {
+      id: '',
+      status: test.status,
+      ...(typeof test.message === 'string' ? { message: test.message } : {}),
+    };
+    if (test.name.startsWith('[f2p] ')) {
+      result.id = test.name.slice('[f2p] '.length);
+      buckets.f2p.push(result);
+    } else if (test.name.startsWith('[p2p] ')) {
+      result.id = test.name.slice('[p2p] '.length);
+      buckets.p2p.push(result);
+    }
+  }
+  return buckets;
+}
+
+function assertDeepSWETestResultCounts(reward: Reward, testResults: DeepSWETestBuckets): void {
+  if (
+    typeof reward.f2p_total !== 'number' ||
+    typeof reward.p2p_total !== 'number' ||
+    testResults.f2p.length !== reward.f2p_total ||
+    testResults.p2p.length !== reward.p2p_total
+  ) {
+    throw new Error('ctrf.json test counts do not match reward.json');
+  }
+}
+
+function p2pBaselinePath(taskName: string, baseCommit: string): string {
+  return path.join(
+    omegaWorkDir(),
+    'deepswe',
+    'baselines',
+    `${taskName}-${baseCommit}.json`
+  );
+}
+
+async function readP2PBaseline(
+  taskName: string,
+  baseCommit: string
+): Promise<DeepSWEP2PBaseline | undefined> {
+  try {
+    const raw = await fs.readFile(p2pBaselinePath(taskName, baseCommit), 'utf-8');
+    const parsed: unknown = JSON.parse(raw);
+    if (typeof parsed !== 'object' || parsed === null) return undefined;
+    const baseline = parsed as Record<string, unknown>;
+    if (
+      baseline.taskName !== taskName ||
+      baseline.baseCommit !== baseCommit ||
+      typeof baseline.computedAt !== 'string' ||
+      !Array.isArray(baseline.failingP2p) ||
+      !baseline.failingP2p.every((id) => typeof id === 'string')
+    ) {
+      return undefined;
+    }
+    return {
+      taskName,
+      baseCommit,
+      computedAt: baseline.computedAt,
+      failingP2p: [...new Set(baseline.failingP2p)],
+    };
+  } catch {
+    return undefined;
+  }
+}
+
+async function writeP2PBaseline(baseline: DeepSWEP2PBaseline): Promise<void> {
+  const baselinePath = p2pBaselinePath(baseline.taskName, baseline.baseCommit);
+  const temporaryPath = `${baselinePath}.${String(process.pid)}-${String(Date.now())}.tmp`;
+  try {
+    await writeFile(temporaryPath, JSON.stringify(baseline, null, 2));
+    await fs.rename(temporaryPath, baselinePath);
+  } finally {
+    await fs.unlink(temporaryPath).catch(() => {
+      // rename removes the temporary path; ignore that expected ENOENT
+    });
+  }
+}
+
+async function gitStdout(projectPath: string, args: string[]): Promise<string> {
+  const { stdout } = await execFileAsync('git', ['-C', projectPath, ...args], {
+    timeout: 60000,
+    maxBuffer: 32 * 1024 * 1024,
+  });
+  return stdout.trim();
+}
+
+async function gitStatus(projectPath: string): Promise<string> {
+  const { stdout } = await execFileAsync(
+    'git',
+    [
+      '-C',
+      projectPath,
+      'status',
+      '--porcelain=v1',
+      '--untracked-files=all',
+      '--ignore-submodules=none',
+    ],
+    { timeout: 60000, maxBuffer: 32 * 1024 * 1024 }
+  );
+  return stdout;
+}
+
+async function stashDirtyCheckout(projectPath: string, label: string): Promise<string | undefined> {
+  const status = await gitStatus(projectPath);
+  if (status.length === 0) return undefined;
+  await execFileAsync(
+    'git',
+    ['-C', projectPath, 'stash', 'push', '--include-untracked', '--message', label],
+    { timeout: 60000, maxBuffer: 32 * 1024 * 1024 }
+  );
+  return gitStdout(projectPath, ['rev-parse', 'refs/stash']);
+}
+
+async function dropTemporaryStash(projectPath: string, commit: string): Promise<void> {
+  const stashCommits = (await gitStdout(projectPath, ['stash', 'list', '--format=%H']))
+    .split('\n')
+    .filter(Boolean);
+  const index = stashCommits.indexOf(commit);
+  if (index === -1) return;
+  await execFileAsync('git', ['-C', projectPath, 'stash', 'drop', `stash@{${String(index)}}`], {
+    timeout: 60000,
+  });
+}
+
+class CheckoutRestoreError extends Error {}
+
+async function assertCheckoutRestored(
+  projectPath: string,
+  originalCommit: string,
+  originalBranch: string | undefined,
+  originalStatus: string
+): Promise<void> {
+  const restoredCommit = await gitStdout(projectPath, ['rev-parse', 'HEAD']);
+  const restoredBranch = await gitStdout(
+    projectPath,
+    ['symbolic-ref', '--quiet', '--short', 'HEAD']
+  ).catch(() => undefined);
+  const restoredStatus = await gitStatus(projectPath);
+  if (
+    restoredCommit !== originalCommit ||
+    restoredBranch !== originalBranch ||
+    restoredStatus !== originalStatus
+  ) {
+    throw new Error('checkout state differs from its pre-baseline state');
+  }
+}
+
+async function withCleanCheckoutRestored<T>(
+  projectPath: string,
+  baseCommit: string,
+  action: () => Promise<T>
+): Promise<T> {
+  const originalCommit = await gitStdout(projectPath, ['rev-parse', 'HEAD']);
+  const originalBranch = await gitStdout(projectPath, ['symbolic-ref', '--quiet', '--short', 'HEAD'])
+    .catch(() => undefined);
+  const originalStatus = await gitStatus(projectPath);
+  const marker = `omega-deepswe-baseline-${String(process.pid)}-${String(Date.now())}`;
+  const originalStash = await stashDirtyCheckout(projectPath, `${marker}-original`);
+
+  let outcome: { ok: true; value: T } | { ok: false; error: unknown };
+  try {
+    await forceCheckout(projectPath, baseCommit);
+    outcome = { ok: true, value: await action() };
+  } catch (error) {
+    outcome = { ok: false, error };
+  }
+
+  let cleanupStash: string | undefined;
+  let retryStash: string | undefined;
+  const restore = async (): Promise<void> => {
+    await forceCheckout(projectPath, originalBranch ?? originalCommit);
+    if (originalStash) {
+      await execFileAsync('git', ['-C', projectPath, 'stash', 'apply', '--index', originalStash], {
+        timeout: 60000,
+        maxBuffer: 32 * 1024 * 1024,
+      });
+    }
+    await assertCheckoutRestored(projectPath, originalCommit, originalBranch, originalStatus);
+  };
+  try {
+    cleanupStash = await stashDirtyCheckout(projectPath, `${marker}-cleanup`);
+    await restore();
+  } catch (firstError) {
+    try {
+      retryStash = await stashDirtyCheckout(projectPath, `${marker}-retry`);
+      await restore();
+    } catch (retryError) {
+      await stashDirtyCheckout(projectPath, `${marker}-failed-restore`).catch(() => undefined);
+      await forceCheckout(projectPath, originalBranch ?? originalCommit).catch(() => undefined);
+      throw new CheckoutRestoreError(
+        `Failed to restore checkout after p2p baseline run: ${errorSummary(retryError)} (initial failure: ${errorSummary(firstError)})`
+      );
+    }
+  }
+
+  for (const temporaryStash of [cleanupStash, retryStash, originalStash]) {
+    if (temporaryStash) {
+      await dropTemporaryStash(projectPath, temporaryStash).catch((error: unknown) => {
+        console.warn(`[deepswe] Failed to drop temporary baseline stash: ${String(error)}`);
+      });
+    }
+  }
+
+  if (!outcome.ok) throw outcome.error;
+  return outcome.value;
+}
+
+function hasP2PFailures(reward: Reward): boolean {
+  return (
+    typeof reward.p2p_total === 'number' &&
+    typeof reward.p2p_passed === 'number' &&
+    reward.p2p_passed < reward.p2p_total
+  );
+}
+
+function p2pDisclosure(reward: Reward): string {
+  return reward.p2p_disclosure ??
+    `p2p ${String(reward.p2p_passed ?? 0)}/${String(reward.p2p_total ?? 0)}`;
+}
+
+function errorSummary(error: unknown): string {
+  const message = error instanceof Error ? error.message : String(error);
+  return message.replace(/\s+/g, ' ').trim().slice(0, 300) || 'unknown error';
+}
+
+async function computeP2PBaseline(
+  projectPath: string,
+  taskDir: string,
+  baseCommit: string,
+  taskName: string
+): Promise<DeepSWEP2PBaseline> {
+  return withCleanCheckoutRestored(projectPath, baseCommit, async () => {
+    const baselineRun = await runDeepSWEVerifierLocal(
+      projectPath,
+      taskDir,
+      baseCommit,
+      taskName,
+      '',
+      false
+    );
+    if (baselineRun.timedOut) throw new Error('clean verifier timed out');
+    if (!baselineRun.testResults) {
+      throw new Error('clean verifier did not produce ctrf.json');
+    }
+    assertDeepSWETestResultCounts(baselineRun.reward, baselineRun.testResults);
+    const failingP2p = failingP2PBaselineIds(baselineRun.testResults.p2p);
+    return {
+      taskName,
+      baseCommit,
+      computedAt: new Date().toISOString(),
+      failingP2p,
+    };
+  });
+}
