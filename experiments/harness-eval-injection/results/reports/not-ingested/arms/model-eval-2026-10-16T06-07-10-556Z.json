                "patch": "diff --git a/src/ratelimit.js b/src/ratelimit.js\nindex 03b4f44..2846973 100644\n--- a/src/ratelimit.js\n+++ b/src/ratelimit.js\n@@ -1,14 +1,34 @@\n export class RateLimiter {\n   constructor(maxConcurrent) {\n+    if (!Number.isInteger(maxConcurrent) || maxConcurrent < 1) {\n+      throw new RangeError('maxConcurrent must be a positive integer');\n+    }\n     this.maxConcurrent = maxConcurrent;\n     this.running = 0;\n+    this.queue = [];\n   }\n-  async run(fn) {\n-    this.running++;\n-    try {\n-      return await fn();\n-    } finally {\n-      this.running--;\n+\n+  // Single drain path: while capacity remains and work is pending,\n+  // take one item and start it.\n+  _drain() {\n+    while (this.running < this.maxConcurrent && this.queue.length > 0) {\n+      const { fn, resolve, reject } = this.queue.shift();\n+      this.running++;\n+      Promise.resolve()\n+        .then(fn)\n+        .then(resolve, reject)\n+        .finally(() => {\n+          this.running--;\n+          // Attempt another drain on every completion, including rejections.\n+          this._drain();\n+        });\n     }\n   }\n+\n+  run(fn) {\n+    return new Promise((resolve, reject) => {\n+      this.queue.push({ fn, resolve, reject });\n+      this._drain();\n+    });\n+  }\n }\n",
