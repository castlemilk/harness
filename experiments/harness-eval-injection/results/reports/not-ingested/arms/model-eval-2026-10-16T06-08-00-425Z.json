                "patch": "diff --git a/src/queue.js b/src/queue.js\nindex 66cc5fe..cdafc1f 100644\n--- a/src/queue.js\n+++ b/src/queue.js\n@@ -4,22 +4,37 @@ export class AsyncQueue {\n     this.maxSize = maxSize;\n     this.running = 0;\n     this.queue = [];\n+    this.waiters = [];\n   }\n-  async push(fn) {\n-    if (this.running >= this.concurrency) {\n-      if (this.queue.length >= this.maxSize) {\n-        throw new Error('Queue full');\n+\n+  push(fn) {\n+    return new Promise((resolve, reject) => {\n+      const entry = { fn, resolve, reject };\n+      if (this.queue.length < this.maxSize) {\n+        this.queue.push(entry);\n+      } else {\n+        this.waiters.push(entry);\n       }\n-      this.queue.push(fn);\n-      return;\n+      this.drain();\n+    });\n+  }\n+\n+  drain() {\n+    // Admit waiting callers into the buffer as slots open, preserving FIFO order.\n+    while (this.queue.length < this.maxSize && this.waiters.length > 0) {\n+      this.queue.push(this.waiters.shift());\n     }\n-    this.running++;\n-    try { await fn(); } finally {\n-      this.running--;\n-      if (this.queue.length > 0) {\n-        const next = this.queue.shift();\n-        this.push(next);\n-      }\n+    // Start buffered work through a single admission path.\n+    while (this.running < this.concurrency && this.queue.length > 0) {\n+      const entry = this.queue.shift();\n+      this.running++;\n+      Promise.resolve()\n+        .then(entry.fn)\n+        .then(entry.resolve, entry.reject)\n+        .finally(() => {\n+          this.running--;\n+          this.drain();\n+        });\n     }\n   }\n }\n",
