                "patch": "diff --git a/src/lru.js b/src/lru.js\nindex faa20a3..3afc0be 100644\n--- a/src/lru.js\n+++ b/src/lru.js\n@@ -5,10 +5,23 @@ export class LRUCache {\n   }\n   get(key) {\n     if (!this.cache.has(key)) return -1;\n-    return this.cache.get(key);\n+    const value = this.cache.get(key);\n+    // Refresh recency: delete and re-insert to move to most-recent position.\n+    this.cache.delete(key);\n+    this.cache.set(key, value);\n+    return value;\n   }\n   set(key, value) {\n+    // Refresh recency if the key already exists.\n+    if (this.cache.has(key)) {\n+      this.cache.delete(key);\n+    }\n     this.cache.set(key, value);\n+    // Enforce capacity after the refresh: evict the single least-recent entry.\n+    if (this.cache.size > this.capacity) {\n+      const oldest = this.cache.keys().next().value;\n+      this.cache.delete(oldest);\n+    }\n   }\n   size() { return this.cache.size; }\n }\n",
