                "patch": "diff --git a/src/ratelimit.js b/src/ratelimit.js\nindex 03b4f44..f5b3f8e 100644\n--- a/src/ratelimit.js\n+++ b/src/ratelimit.js\n@@ -2,13 +2,34 @@ export class RateLimiter {\n   constructor(maxConcurrent) {\n     this.maxConcurrent = maxConcurrent;\n     this.running = 0;\n+    this.queue = [];\n   }\n-  async run(fn) {\n-    this.running++;\n-    try {\n-      return await fn();\n-    } finally {\n-      this.running--;\n+\n+  run(fn) {\n+    return new Promise((resolve, reject) => {\n+      const start = () => {\n+        this.running++;\n+        Promise.resolve()\n+          .then(fn)\n+          .then(resolve, reject)\n+          .finally(() => {\n+            this.running--;\n+            this.drain();\n+          });\n+      };\n+\n+      if (this.running < this.maxConcurrent) {\n+        start();\n+      } else {\n+        this.queue.push(start);\n+      }\n+    });\n+  }\n+\n+  drain() {\n+    while (this.running < this.maxConcurrent && this.queue.length > 0) {\n+      const next = this.queue.shift();\n+      next();\n     }\n   }\n }\n",
