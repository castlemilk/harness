                "patch": "diff --git a/src/lru.js b/src/lru.js\nindex faa20a3..fb32fa8 100644\n--- a/src/lru.js\n+++ b/src/lru.js\n@@ -5,10 +5,23 @@ export class LRUCache {\n   }\n   get(key) {\n     if (!this.cache.has(key)) return -1;\n-    return this.cache.get(key);\n+    const value = this.cache.get(key);\n+    // Refresh recency: delete and re-insert so this key becomes newest.\n+    this.cache.delete(key);\n+    this.cache.set(key, value);\n+    return value;\n   }\n   set(key, value) {\n+    // If the key already exists, remove it first so it re-inserts as newest.\n+    if (this.cache.has(key)) {\n+      this.cache.delete(key);\n+    }\n     this.cache.set(key, value);\n+    // Evict the oldest entry (first inserted) when over capacity.\n+    if (this.cache.size > this.capacity) {\n+      const oldestKey = this.cache.keys().next().value;\n+      this.cache.delete(oldestKey);\n+    }\n   }\n   size() { return this.cache.size; }\n }\n",
