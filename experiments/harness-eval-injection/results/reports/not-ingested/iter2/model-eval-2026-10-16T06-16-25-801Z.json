                "patch": "diff --git a/src/ratelimit.js b/src/ratelimit.js\nindex 03b4f44..a9868be 100644\n--- a/src/ratelimit.js\n+++ b/src/ratelimit.js\n@@ -2,13 +2,29 @@ export class RateLimiter {\n   constructor(maxConcurrent) {\n     this.maxConcurrent = maxConcurrent;\n     this.running = 0;\n+    this.queue = [];\n   }\n+\n   async run(fn) {\n-    this.running++;\n+    if (this.running >= this.maxConcurrent) {\n+      // No slot available: wait until one is handed to us.\n+      await new Promise(resolve => this.queue.push(resolve));\n+    } else {\n+      // Claim a free slot immediately.\n+      this.running++;\n+    }\n+\n     try {\n       return await fn();\n     } finally {\n-      this.running--;\n+      const next = this.queue.shift();\n+      if (next) {\n+        // Hand the slot directly to the next waiting task so the\n+        // concurrency limit can never be exceeded.\n+        next();\n+      } else {\n+        this.running--;\n+      }\n     }\n   }\n }\n",
