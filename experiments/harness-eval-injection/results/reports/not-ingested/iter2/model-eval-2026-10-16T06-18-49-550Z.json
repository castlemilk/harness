                "patch": "diff --git a/src/lru.js b/src/lru.js\nindex faa20a3..8889931 100644\n--- a/src/lru.js\n+++ b/src/lru.js\n@@ -5,10 +5,24 @@ export class LRUCache {\n   }\n   get(key) {\n     if (!this.cache.has(key)) return -1;\n-    return this.cache.get(key);\n+    const value = this.cache.get(key);\n+    // Refresh recency: move accessed key to the most-recent end.\n+    this.cache.delete(key);\n+    this.cache.set(key, value);\n+    return value;\n   }\n   set(key, value) {\n+    // Re-inserting an existing key also refreshes its recency.\n+    if (this.cache.has(key)) {\n+      this.cache.delete(key);\n+    }\n     this.cache.set(key, value);\n+    // Enforce capacity after the recency update: evict the least-recent\n+    // entry (the first key in insertion order) for each over-capacity insert.\n+    while (this.cache.size > this.capacity) {\n+      const oldest = this.cache.keys().next().value;\n+      this.cache.delete(oldest);\n+    }\n   }\n   size() { return this.cache.size; }\n }\n",
