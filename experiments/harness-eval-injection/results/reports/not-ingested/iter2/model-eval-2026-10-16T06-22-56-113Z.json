                "patch": "diff --git a/src/clone.js b/src/clone.js\nindex ff24a42..fedf1fa 100644\n--- a/src/clone.js\n+++ b/src/clone.js\n@@ -1,9 +1,20 @@\n-export function deepClone(obj) {\n+export function deepClone(obj, seen = new WeakMap()) {\n   if (obj === null || typeof obj !== 'object') return obj;\n-  if (Array.isArray(obj)) return obj.map(item => deepClone(item));\n+  // If this container was already cloned, return the copy so that\n+  // internal (possibly circular) references point into the clone.\n+  if (seen.has(obj)) return seen.get(obj);\n+  if (Array.isArray(obj)) {\n+    const clone = [];\n+    // Register the new container before visiting children so cycles\n+    // re-enter the memo instead of recursing infinitely.\n+    seen.set(obj, clone);\n+    for (const item of obj) clone.push(deepClone(item, seen));\n+    return clone;\n+  }\n   const clone = {};\n+  seen.set(obj, clone);\n   for (const key of Object.keys(obj)) {\n-    clone[key] = deepClone(obj[key]);\n+    clone[key] = deepClone(obj[key], seen);\n   }\n   return clone;\n }\n",
