                "patch": "diff --git a/src/lru.js b/src/lru.js\nindex faa20a3..0ef6363 100644\n--- a/src/lru.js\n+++ b/src/lru.js\n@@ -5,10 +5,21 @@ export class LRUCache {\n   }\n   get(key) {\n     if (!this.cache.has(key)) return -1;\n-    return this.cache.get(key);\n+    const value = this.cache.get(key);\n+    // Refresh recency: move to the most-recently-used position.\n+    this.cache.delete(key);\n+    this.cache.set(key, value);\n+    return value;\n   }\n   set(key, value) {\n+    // Refresh recency for existing keys before re-inserting.\n+    if (this.cache.has(key)) this.cache.delete(key);\n     this.cache.set(key, value);\n+    // Enforce capacity after updating recency, evicting the least-recent entry.\n+    if (this.cache.size > this.capacity) {\n+      const oldest = this.cache.keys().next().value;\n+      this.cache.delete(oldest);\n+    }\n   }\n   size() { return this.cache.size; }\n }\n",
