                "commitSha": null,
                "patch": "diff --git a/src/clone.js b/src/clone.js\nindex ff24a42..a6d02b1 100644\n--- a/src/clone.js\n+++ b/src/clone.js\n@@ -1,9 +1,29 @@\n export function deepClone(obj) {\n+  return clone(obj, new WeakMap());\n+}\n+\n+function clone(obj, seen) {\n   if (obj === null || typeof obj !== 'object') return obj;\n-  if (Array.isArray(obj)) return obj.map(item => deepClone(item));\n-  const clone = {};\n+\n+  // If we have already started cloning this object, return the in-progress\n+  // copy. This both breaks cycles and preserves shared references.\n+  if (seen.has(obj)) return seen.get(obj);\n+\n+  if (Array.isArray(obj)) {\n+    const result = [];\n+    // Register the container before descending so any reference back to it\n+    // resolves inside the copy instead of recursing again.\n+    seen.set(obj, result);\n+    for (const item of obj) {\n+      result.push(clone(item, seen));\n+    }\n+    return result;\n+  }\n+\n+  const result = {};\n+  seen.set(obj, result);\n   for (const key of Object.keys(obj)) {\n-    clone[key] = deepClone(obj[key]);\n+    result[key] = clone(obj[key], seen);\n   }\n-  return clone;\n+  return result;\n }\n",
