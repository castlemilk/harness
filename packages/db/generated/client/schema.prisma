generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String      @id @default(uuid())
  name        String
  path        String      @unique
  repoUrl     String?
  description String?
  env         String? // JSON
  createdAt   DateTime    @default(now())
  tasks       Task[]
  objectives  Objective[]
}

model Task {
  id           String      @id @default(uuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       String      @default("todo")
  complexity   String      @default("simple")
  tags         String? // JSON array
  provider     String?
  model        String?
  result       String?
  error        String?
  retryCount   Int         @default(0)
  lastRetryAt  DateTime?
  retryHistory String? // JSON: [{ strategy, provider, model, error, timestamp }]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  steps        TaskStep[]
  traces       TaskTrace[]
  diffs        TaskDiff[]
  agentRuns    AgentRun[]
  traceSpans   TraceSpan[]

  @@index([status, createdAt])
  @@index([projectId])
  @@index([provider, createdAt])
}

model TaskStep {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  idx       Int
  name      String
  status    String   @default("pending")
  input     String? // JSON or free text
  output    String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model TaskTrace {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepId    String?
  role      String // system | user | assistant | tool
  content   String?
  toolCalls String? // JSON
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskDiff {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  branch    String
  commitSha String?
  patch     String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model AgentRun {
  id                       String         @id @default(uuid())
  taskId                   String
  task                     Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  promptVersionId          String?
  promptVersion            PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  branch                   String
  baseCommit               String
  resultStatus             String         @default("running")
  validationSummary        String? // JSON
  publishedVersion         String?
  promptTokens             Int?
  completionTokens         Int?
  totalTokens              Int?
  costUsd                  Float?
  turnCount                Int?
  toolCalls                String? // JSON: { toolName: count, ... }
  turnDurationMs           Int?
  phaseTimings             String? // JSON: { phaseName: durationMs, ... }
  currentPhase             String?
  currentPhaseStartedAt    DateTime?
  currentTurn              Int?
  providerCalls            Int            @default(0)
  providerRetries          Int            @default(0)
  providerRateLimitRetries Int            @default(0)
  providerRotations        Int            @default(0)
  providerLastStatus       Int?
  effectiveModel           String?
  modelsTried              String? // JSON array
  tokenBudget              Int?
  tokenBudgetExceeded      Boolean        @default(false)
  deadlineMs               Int?
  deadlineRemainingMs      Int?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([taskId])
  @@index([promptVersionId])
  @@index([createdAt])
}

model TraceSpan {
  id         String    @id @default(uuid())
  traceId    String
  spanId     String
  parentId   String?
  taskId     String?
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name       String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  status     String    @default("ok") // ok | error
  attributes String? // JSON
  events     String? // JSON

  @@index([traceId])
  @@index([taskId])
}

model ProviderConfig {
  id             String    @id @default(uuid())
  name           String    @unique
  kind           String
  baseUrl        String?
  apiKey         String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  defaultModel   String
  capabilities   String // JSON
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model SkillArtifact {
  id            String   @id @default(uuid())
  name          String   @unique
  sourcePath    String
  generatedPath String
  manifest      String // JSON
  registeredAt  DateTime @default(now())
}

model PromptVersion {
  id              String     @id @default(uuid())
  name            String     @unique
  sourcePath      String
  systemPrompt    String
  textToolsPrompt String
  planningPrompt  String?
  skillContext    String?
  hash            String
  metadata        String? // JSON
  benchmarkScore  Float?
  agentRuns       AgentRun[]
  createdAt       DateTime   @default(now())
}

model BenchmarkHistory {
  id              String   @id @default(uuid())
  suite           String
  provider        String?
  model           String?
  totalTasks      Int
  passed          Int
  failed          Int
  timeouts        Int
  passRate        Float
  totalDurationMs Int
  totalCostUsd    Float?
  totalTokens     Int?
  metadata        String? // JSON: per-task results, variance data, etc.
  reportPath      String?
  createdAt       DateTime @default(now())

  @@index([suite])
  @@index([provider, model])
  @@index([createdAt])
}

model BenchmarkRun {
  id              String    @id @default(uuid())
  suite           String
  status          String    @default("pending") // pending | running | done | failed | cancelled
  config          String // JSON: { models, strategy, concurrency, timeoutMs, tokenBudget, ... }
  totalTasks      Int       @default(0)
  passed          Int       @default(0)
  failed          Int       @default(0)
  timeouts        Int       @default(0)
  totalDurationMs Int       @default(0)
  totalCostUsd    Float?
  totalTokens     Int?
  results         String? // JSON: per-task results
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([suite])
  @@index([createdAt])
}

model ProviderCircuitState {
  providerName   String    @id
  state          String    @default("closed") // closed, open, half-open
  errorRate      Float     @default(0)
  lastFailureAt  DateTime?
  lastSuccessAt  DateTime?
  cooldownUntil  DateTime?
  trialStartedAt DateTime?
  trialRequestId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Objective {
  id            String           @id @default(uuid())
  projectId     String
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  status        String           @default("active")
  /// Use-case shell id (a lowercase slug, e.g. "victoria"). Null means the
  /// objective renders with the core Foreman chrome only.
  useCase       String?
  targetDate    DateTime?
  spendCapUsd   Float?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  phases        ObjectivePhase[]
  workstreams   Workstream[]
  harnesses     Harness[]
  interventions Intervention[]

  @@index([projectId])
}

model ObjectivePhase {
  id          String    @id @default(uuid())
  objectiveId String
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  name        String
  state       String
  weight      Float     @default(1)
  detail      String?
  orderIdx    Int

  @@index([objectiveId])
}

model Workstream {
  id            String    @id @default(uuid())
  objectiveId   String
  objective     Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  name          String
  paused        Boolean   @default(false)
  pausedAt      DateTime?
  pausedNote    String?
  orderIdx      Int       @default(0)
  leadHarnessId String?
  harnesses     Harness[]

  @@index([objectiveId])
}

model Harness {
  id                String        @id @default(uuid())
  objectiveId       String
  objective         Objective     @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  workstreamId      String?
  workstream        Workstream?   @relation(fields: [workstreamId], references: [id], onDelete: SetNull)
  parentId          String?
  parent            Harness?      @relation("HarnessTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          Harness[]     @relation("HarnessTree")
  name              String
  status            String        @default("ready")
  statusBeforePause String?
  activity          String?
  mission           String
  currentJob        String?
  model             String
  playbookId        String?
  taskId            String?
  branch            String?
  heartbeatMinutes  Int           @default(30)
  nextPulseAt       DateTime?
  maxChildren       Int           @default(3)
  spendCapUsd       Float?
  spendUsd          Float         @default(0)
  contextTokens     Int           @default(0)
  contextWindow     Int           @default(200000)
  permissions       String        @default("[]")
  dryRun            Boolean       @default(false)
  lastPulseSeq      Int           @default(0)
  idleSince         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  retiredAt         DateTime?
  pulses            Pulse[]
  tools             HarnessTool[]

  @@index([objectiveId, status])
  @@index([parentId])
  @@index([workstreamId])
}

model Pulse {
  id        String    @id @default(uuid())
  harnessId String
  harness   Harness   @relation(fields: [harnessId], references: [id], onDelete: Cascade)
  seq       Int
  startedAt DateTime
  endedAt   DateTime?
  outcome   String
  summary   String?
  costUsd   Float     @default(0)
  tokens    Int       @default(0)
  weight    Float     @default(0.5)

  @@unique([harnessId, seq])
  @@index([harnessId, seq(sort: Desc)])
  @@index([harnessId, startedAt(sort: Desc)])
}

model Intervention {
  id          String    @id @default(uuid())
  objectiveId String
  objective   Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  harnessId   String
  kind        String
  title       String
  detail      String?
  impact      String?
  payload     String?
  status      String    @default("pending")
  response    String?
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([objectiveId, status])
}

model Playbook {
  id                String   @id @default(uuid())
  projectId         String?
  name              String
  version           Int      @default(1)
  variables         String   @default("[]")
  cadence           String   @default("every 30m")
  retireWhen        String?
  steps             String   @default("[]")
  previousVersionId String?
  createdAt         DateTime @default(now())

  @@unique([name, version])
}

model HarnessTool {
  id                     String    @id @default(uuid())
  harnessId              String
  harness                Harness   @relation(fields: [harnessId], references: [id], onDelete: Cascade)
  name                   String
  groupName              String
  needsApproval          Boolean   @default(false)
  lastStatus             String?
  lastResultLabel        String?
  lastRanAt              DateTime?
  // The shell command this tool runs, in the objective's project checkout.
  // NULL means the tool has no execution configured: running it records the
  // request and executes nothing, which is what every tool did before.
  command                String?
  // Which `Harness.permissions` entry authorises this tool. Defaults to
  // `tool:<id>` when unset.
  permissionId           String?
  // Per-tool wall-clock bound; NULL falls back to the 60s default.
  timeoutMs              Int?
  // Set when a human approved ONE run via an intervention. Consumed by the
  // next run of this tool and cleared, so approval never becomes standing.
  approvedInterventionId String?

  runs HarnessToolRun[]

  @@index([harnessId])
}

/// One attempted invocation of a HarnessTool — recorded, blocked, or executed.
/// This is the audit trail: it exists even when nothing ran.
model HarnessToolRun {
  id             String      @id @default(uuid())
  toolId         String
  tool           HarnessTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  harnessId      String
  /// recorded | blocked-pending-approval | ok | fail | timeout | error
  status         String
  label          String
  command        String?
  cwd            String?
  exitCode       Int?
  durationMs     Int?
  /// The permission id that authorised the run, if a standing permission did.
  permissionId   String?
  /// The intervention that authorised (one-shot approval) or blocked this run.
  interventionId String?
  /// Bounded excerpt of the combined stdout/stderr.
  output         String?
  createdAt      DateTime    @default(now())

  @@index([toolId, createdAt(sort: Desc)])
  @@index([harnessId, createdAt(sort: Desc)])
}
