generator client {
  provider        = "prisma-client-js"
  output          = "../generated/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  path        String   @unique
  repoUrl     String?
  description String?
  env         String? // JSON
  createdAt   DateTime @default(now())
  tasks       Task[]
}

model Task {
  id           String      @id @default(uuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       String      @default("todo")
  complexity   String      @default("simple")
  tags         String? // JSON array
  provider     String?
  model        String?
  result       String?
  error        String?
  retryCount   Int         @default(0)
  lastRetryAt  DateTime?
  retryHistory String? // JSON: [{ strategy, provider, model, error, timestamp }]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  steps        TaskStep[]
  traces       TaskTrace[]
  diffs        TaskDiff[]
  agentRuns    AgentRun[]
  traceSpans   TraceSpan[]

  @@index([status, createdAt])
  @@index([projectId])
  @@index([provider, createdAt])
}

model TaskStep {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  idx       Int
  name      String
  status    String   @default("pending")
  input     String? // JSON or free text
  output    String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model TaskTrace {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  stepId    String?
  role      String // system | user | assistant | tool
  content   String?
  toolCalls String? // JSON
  createdAt DateTime @default(now())

  @@index([taskId])
}

model TaskDiff {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  branch    String
  commitSha String?
  patch     String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model AgentRun {
  id                    String         @id @default(uuid())
  taskId                String
  task                  Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  promptVersionId       String?
  promptVersion         PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  branch                String
  baseCommit            String
  resultStatus          String         @default("running")
  validationSummary     String? // JSON
  publishedVersion      String?
  promptTokens          Int?
  completionTokens      Int?
  totalTokens           Int?
  costUsd               Float?
  turnCount             Int?
  toolCalls             String? // JSON: { toolName: count, ... }
  turnDurationMs        Int?
  phaseTimings          String? // JSON: { phaseName: durationMs, ... }
  currentPhase          String?
  currentPhaseStartedAt DateTime?
  currentTurn           Int?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([taskId])
  @@index([promptVersionId])
  @@index([createdAt])
}

model TraceSpan {
  id         String    @id @default(uuid())
  traceId    String
  spanId     String
  parentId   String?
  taskId     String?
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name       String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  status     String    @default("ok") // ok | error
  attributes String? // JSON
  events     String? // JSON

  @@index([traceId])
  @@index([taskId])
}

model ProviderConfig {
  id             String    @id @default(uuid())
  name           String    @unique
  kind           String
  baseUrl        String?
  apiKey         String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  defaultModel   String
  capabilities   String // JSON
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model SkillArtifact {
  id            String   @id @default(uuid())
  name          String   @unique
  sourcePath    String
  generatedPath String
  manifest      String // JSON
  registeredAt  DateTime @default(now())
}

model PromptVersion {
  id              String     @id @default(uuid())
  name            String     @unique
  sourcePath      String
  systemPrompt    String
  textToolsPrompt String
  planningPrompt  String?
  skillContext    String?
  hash            String
  metadata        String? // JSON
  benchmarkScore  Float?
  agentRuns       AgentRun[]
  createdAt       DateTime   @default(now())
}

model BenchmarkHistory {
  id              String   @id @default(uuid())
  suite           String
  provider        String?
  model           String?
  totalTasks      Int
  passed          Int
  failed          Int
  timeouts        Int
  passRate        Float
  totalDurationMs Int
  totalCostUsd    Float?
  totalTokens     Int?
  metadata        String? // JSON: per-task results, variance data, etc.
  reportPath      String?
  createdAt       DateTime @default(now())

  @@index([suite])
  @@index([provider, model])
  @@index([createdAt])
}

model BenchmarkRun {
  id              String    @id @default(uuid())
  suite           String
  status          String    @default("pending") // pending | running | done | failed | cancelled
  config          String // JSON: { models, strategy, concurrency, timeoutMs, tokenBudget, ... }
  totalTasks      Int       @default(0)
  passed          Int       @default(0)
  failed          Int       @default(0)
  timeouts        Int       @default(0)
  totalDurationMs Int       @default(0)
  totalCostUsd    Float?
  totalTokens     Int?
  results         String? // JSON: per-task results
  error           String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([suite])
  @@index([createdAt])
}

model ProviderCircuitState {
  providerName   String    @id
  state          String    @default("closed") // closed, open, half-open
  errorRate      Float     @default(0)
  lastFailureAt  DateTime?
  lastSuccessAt  DateTime?
  cooldownUntil  DateTime?
  trialStartedAt DateTime?
  trialRequestId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
