{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // The `/ui` entry point is React components, so the build compiles .tsx.
    // `react-jsx` (not `react`) because the kit ships to consumers that no
    // longer import React themselves — the automatic runtime emits
    // `react/jsx-runtime` imports, which every React 18 host resolves.
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*"],
  // `dist/` is what consumers resolve, and a consumer has no use for the kit's
  // own tests — before this they shipped as `dist/*.test.js` (+ maps + `.d.ts`),
  // dead weight in every bundle that pulls the package in.
  //
  // The tests are still typechecked, just not by THIS project: `tsconfig.test.json`
  // is the same settings with the exclusion lifted and `noEmit`, and the kit's
  // `build` script runs it straight after the emit. That matters because
  // `src/example-plugin.test.ts` is the kit's type-level test — the compiler is
  // its real assertion — and vitest would not have caught it, esbuild strips
  // types without checking them. Same gate, same command, no emitted tests.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
